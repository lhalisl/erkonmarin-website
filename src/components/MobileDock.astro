---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
---

<nav class="dock" aria-label="Hızlı iletişim" data-dock>
  <a class="dock__item" href={site.phones[0].href}>
    <Icon name="phone" />
    <span>Ara</span>
  </a>
  <a class="dock__item" href={whatsappLink()} target="_blank" rel="noopener">
    <Icon name="whatsapp" />
    <span>WhatsApp</span>
  </a>
  <a class="dock__item dock__item--cta" href="#talep">
    <span>Servis talebi</span>
    <Icon name="arrow" />
  </a>
</nav>

<script>
  // Hide the dock while the request form itself is on screen
  const dock = document.querySelector<HTMLElement>('[data-dock]');
  const target = document.getElementById('talep');
  if (dock && target) {
    new IntersectionObserver(([e]) => dock.toggleAttribute('data-hidden', e.isIntersecting), { threshold: 0.15 }).observe(target);
  }
</script>

<style>
  .dock {
    display: none;
  }
  @media (max-width: 760px) {
    .dock {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      z-index: 90;
      display: grid;
      grid-template-columns: 1fr 1fr 1.6fr;
      gap: 1px;
      background: var(--c-line-dark-2);
      border: 1px solid var(--c-line-dark-2);
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.6);
      transition:
        transform 0.45s var(--ease-out),
        opacity 0.3s;
    }
    .dock[data-hidden] {
      transform: translateY(140%);
      opacity: 0;
    }
    .dock__item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 54px;
      background: rgba(5, 10, 25, 0.96);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
    }
    .dock__item :global(svg) {
      width: 18px;
      height: 18px;
      color: var(--c-signal);
    }
    .dock__item--cta {
      background: var(--c-signal);
      color: var(--c-abyss);
    }
    .dock__item--cta :global(svg) {
      color: var(--c-abyss);
    }
  }
</style>
