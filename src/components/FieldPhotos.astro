---
import { accent } from '../lib/utils';
import { Image } from 'astro:assets';
import { galleryRows } from '../data/photos';
import { anchors, langOf } from '../i18n';

const lang = langOf(Astro.currentLocale);
const copy = {
  tr: {
    title: ['Sahadan,', 'gerçek', 'işler.'],
    lead: 'Ana panodan makine dairesine, köprüüstüne kadar gemide çalıştığımız sistemlerden kareler.',
  },
  en: {
    title: ['Real work,', 'from the', 'field.'],
    lead: 'Shots of the shipboard systems we work on, from the main switchboard to the engine room and the bridge.',
  },
}[lang];

// Justified rows: each photo's flex-grow and aspect-ratio are its own
// width/height, so photos in a row share one height and are never cropped.
const ratio = (w: number, h: number) => +(w / h).toFixed(4);

// Rendered width: full column on phones; on wider screens the photo's share of the
// container's content box (100vw minus ~8.4vw gutters, capped at 1352px).
const CONTENT_MAX = 1352;
const sizesFor = (share: number) =>
  [
    '(max-width: 760px) calc(100vw - 40px)',
    `(min-width: 1476px) ${Math.round(share * CONTENT_MAX)}px`,
    `${Math.round(share * 91.6)}vw`,
  ].join(', ');
---

{
  galleryRows.length > 0 && (
    <section class="sahadan" id={anchors.field[lang]} aria-labelledby="field-title">
      <div class="container">
        <header class="sahadan__head">
          <h2 class="h2" id="field-title" data-reveal>
            {copy.title[0]} <em class={accent(copy.title[1])}>{copy.title[1]}</em> {copy.title[2]}
          </h2>
          <p class="sahadan__lead" data-reveal style="--d:120">
            {copy.lead}
          </p>
        </header>

        <div class="sahadan__rows">
          {galleryRows.map((row, r) => (
            <div class="sahadan__row">
              {row.map((p, i) => {
                const ar = ratio(p.src.width, p.src.height);
                const share = ar / row.reduce((sum, q) => sum + ratio(q.src.width, q.src.height), 0);
                return (
                  <figure class="sahadan__item" style={`--ar:${ar};--d:${(r * 2 + i) * 80}`} data-reveal>
                    <Image
                      src={p.src}
                      alt={p.alt[lang]}
                      widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= p.src.width)}
                      sizes={sizesFor(share)}
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                    />
                    {p.caption && <figcaption>{p.caption[lang]}</figcaption>}
                  </figure>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .sahadan {
    padding-block: clamp(96px, 12vw, 170px);
    background: var(--c-deep);
  }
  .sahadan__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 40px;
    align-items: end;
  }
  .sahadan__head .h2 em {
    color: var(--c-signal);
  }
  .sahadan__lead {
    max-width: 420px;
    color: #c9d3ea;
    font-size: clamp(17px, 1.35vw, 20px);
  }

  .sahadan__rows {
    display: grid;
    gap: 14px;
    margin-top: clamp(48px, 6vw, 80px);
  }
  .sahadan__row {
    display: flex;
    gap: 14px;
  }
  .sahadan__item {
    position: relative;
    container-type: inline-size;
    flex: var(--ar) 1 0;
    min-width: 0;
    aspect-ratio: var(--ar);
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-night);
  }
  .sahadan__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .sahadan__item:hover :global(img) {
    transform: scale(1.03);
  }
  .sahadan__item figcaption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    max-width: calc(100% - 32px);
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: rgba(6, 12, 30, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 600;
  }

  /* narrow tiles (the portrait panel on tablets): tighter caption */
  @container (max-width: 260px) {
    .sahadan__item figcaption {
      left: 10px;
      bottom: 10px;
      max-width: calc(100% - 20px);
      padding: 6px 10px;
      font-size: 12.5px;
      line-height: 1.3;
    }
  }

  @media (max-width: 760px) {
    .sahadan__head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .sahadan__rows,
    .sahadan__row {
      gap: 10px;
    }
    .sahadan__row {
      flex-direction: column;
    }
    .sahadan__item {
      flex: none;
      width: 100%;
    }
    .sahadan__item figcaption {
      left: 12px;
      bottom: 12px;
      font-size: 13.5px;
    }
  }
</style>
