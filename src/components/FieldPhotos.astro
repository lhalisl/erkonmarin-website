---
import { Image } from 'astro:assets';
import { galleryRows } from '../data/photos';

// Justified rows: each photo's flex-grow and aspect-ratio are its own
// width/height, so photos in a row share one height and are never cropped.
const ratio = (w: number, h: number) => +(w / h).toFixed(4);
---

{
  galleryRows.length > 0 && (
    <section class="sahadan" id="sahadan" aria-labelledby="field-title">
      <div class="container">
        <header class="sahadan__head">
          <h2 class="h2" id="field-title" data-reveal>
            Sahadan, <em>gerçek</em> işler.
          </h2>
          <p class="sahadan__lead" data-reveal style="--d:120">
            Ana panodan köprüüstüne, gemide çalıştığımız sistemlerden kareler.
          </p>
        </header>

        <div class="sahadan__rows">
          {galleryRows.map((row, r) => (
            <div class="sahadan__row">
              {row.map((p, i) => {
                const ar = ratio(p.src.width, p.src.height);
                const share = ar / row.reduce((sum, q) => sum + ratio(q.src.width, q.src.height), 0);
                return (
                  <figure class="sahadan__item" style={`--ar:${ar};--d:${(r * 2 + i) * 80}`} data-reveal>
                    <Image
                      src={p.src}
                      alt={p.alt}
                      widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= p.src.width)}
                      sizes={`(max-width: 760px) 100vw, ${Math.round(share * 100)}vw`}
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                    />
                    {p.caption && <figcaption>{p.caption}</figcaption>}
                  </figure>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .sahadan {
    padding-block: clamp(96px, 12vw, 170px);
    background: var(--c-deep);
  }
  .sahadan__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 40px;
    align-items: end;
  }
  .sahadan__head .h2 em {
    color: var(--c-signal);
  }
  .sahadan__lead {
    max-width: 420px;
    color: #c9d3ea;
    font-size: clamp(17px, 1.35vw, 20px);
  }

  .sahadan__rows {
    display: grid;
    gap: 14px;
    margin-top: clamp(48px, 6vw, 80px);
  }
  .sahadan__row {
    display: flex;
    gap: 14px;
  }
  .sahadan__item {
    position: relative;
    flex: var(--ar) 1 0;
    min-width: 0;
    aspect-ratio: var(--ar);
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-night);
  }
  .sahadan__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .sahadan__item:hover :global(img) {
    transform: scale(1.03);
  }
  .sahadan__item figcaption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 10px;
    background: rgba(6, 12, 30, 0.55);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: #fff;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .sahadan__head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .sahadan__rows,
    .sahadan__row {
      gap: 10px;
    }
    .sahadan__row {
      flex-direction: column;
    }
    .sahadan__item {
      flex: none;
      width: 100%;
    }
    .sahadan__item figcaption {
      left: 12px;
      bottom: 12px;
      font-size: 13.5px;
    }
  }
</style>
