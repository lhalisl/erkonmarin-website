---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Real project photos from src/assets/sahadan/, sorted by file name.
// The section is omitted entirely while the folder holds no images.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/sahadan/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', {
  eager: true,
});
const ON_HOME = 7;
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b, 'tr'))
  .slice(0, ON_HOME)
  .map(([, mod]) => mod.default);
---

{
  photos.length > 0 && (
    <section class="field" id="sahadan" aria-labelledby="field-title">
      <div class="container">
        <header class="field__head">
          <h2 class="h2" id="field-title" data-reveal>
            Sahadan, <em>gerçek</em> işler.
          </h2>
          <p class="field__lead" data-reveal style="--d:120">
            Kontrol odalarından ana panolara, gemide yaptığımız işlerden kareler.
          </p>
        </header>
        <ul class:list={['field__grid', `field__grid--${Math.min(photos.length, ON_HOME)}`]} role="list">
          {photos.map((src, i) => (
            <li class="field__item" data-reveal style={`--d:${i * 60}`}>
              <Image
                src={src}
                alt={`Erkon Marin saha çalışması ${i + 1}`}
                widths={i === 0 ? [640, 960, 1400, 1900] : [480, 720, 1000]}
                sizes={i === 0 ? '(max-width: 760px) 100vw, 58vw' : '(max-width: 760px) 100vw, 34vw'}
                format="webp"
                quality={78}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .field {
    padding-block: clamp(96px, 12vw, 170px);
    background: var(--c-deep);
  }
  .field__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 40px;
    align-items: end;
  }
  .field__head .h2 em {
    color: var(--c-signal);
  }
  .field__lead {
    max-width: 420px;
    color: #c9d3ea;
    font-size: clamp(17px, 1.35vw, 20px);
  }

  .field__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(160px, 17vw, 270px);
    gap: 14px;
    margin: clamp(48px, 6vw, 80px) 0 0;
  }
  .field__item {
    position: relative;
    grid-column: span 4;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--c-night);
  }
  /* lead photo: large, two rows */
  .field__item:first-child {
    grid-column: span 7;
    grid-row: span 2;
  }
  .field__item:nth-child(2),
  .field__item:nth-child(3) {
    grid-column: span 5;
  }
  .field__grid--1 .field__item:first-child {
    grid-column: 1 / -1;
  }
  .field__grid--2 .field__item:nth-child(2) {
    grid-row: span 2;
  }
  .field__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .field__item:hover :global(img) {
    transform: scale(1.04);
  }

  @media (max-width: 760px) {
    .field__head {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .field__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 42vw;
      gap: 10px;
    }
    .field__item,
    .field__item:nth-child(2),
    .field__item:nth-child(3) {
      grid-column: span 1;
    }
    .field__item:first-child {
      grid-column: 1 / -1;
      grid-row: span 2;
    }
  }
</style>
