---
import Icon from './Icon.astro';
import { site, nav, whatsappLink, requestHref } from '../data/site';

// Mark the page link (not the in-page anchors) for the page being viewed
const trim = (path: string) => path.replace(/\/+$/, '');
const here = trim(Astro.url.pathname);
// 'page' on the page itself, 'true' on its sub pages (e.g. Hizmetler on a service page)
const current = (href: string) => {
  if (href.includes('#')) return undefined;
  const target = trim(href);
  if (here === target) return 'page';
  return target && here.startsWith(`${target}/`) ? 'true' : undefined;
};
const request = requestHref(Astro.url.pathname);
---

<header class="site-header" data-header>
  <div class="container">
    <div class="bar">
      <a class="brand" href="/" aria-label="Erkon Marin, ana sayfa">
        <svg class="brand__mark" aria-hidden="true"><use href="#erkon-mark"></use></svg>
        <span class="brand__word" aria-hidden="true"><span class="brand__a">ERKON</span><span class="brand__b">MARİN</span></span>
      </a>

      <nav class="nav" aria-label="Ana menü">
        <ul role="list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="bar__actions">
        <a class="bar__phone" href={site.phones[0].href}>
          <Icon name="phone" />
          <span>{site.phones[0].display}</span>
        </a>
        <a class="btn btn--signal bar__cta" href={request}>
          <span>Servis talebi</span>
          <Icon name="arrow" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <span class="visually-hidden" data-menu-label>Menüyü aç</span>
          <Icon name="menu" class="menu-toggle__open" />
          <Icon name="close" class="menu-toggle__close" />
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="container mobile-menu__inner" aria-label="Mobil menü">
      <ol role="list" class="mobile-menu__list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} data-menu-link aria-current={current(item.href)}>
                <span class="numeral">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="mobile-menu__contact">
        {
          site.phones.map((p) => (
            <a class="mobile-menu__phone" href={p.href}>
              {p.display}
            </a>
          ))
        }
        <p>{site.hours.label}</p>
        <a class="btn btn--ghost" href={whatsappLink()} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span>WhatsApp’tan yazın</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;

  const bar = header.querySelector<HTMLElement>('.bar')!;
  const lightSections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-tone="light"]'));

  // Scrolled state, and a light/dark tone that follows the section under the bar
  const update = () => {
    header.toggleAttribute('data-scrolled', window.scrollY > 24);
    const b = bar.getBoundingClientRect();
    const y = b.top + b.height / 2;
    const light =
      !header.hasAttribute('data-menu-open') &&
      lightSections.some((sec) => {
        const r = sec.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      });
    header.dataset.tone = light ? 'light' : 'dark';
  };
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update();

  // Mobile menu
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const setMenu = (isOpen: boolean) => {
    toggle.setAttribute('aria-expanded', String(isOpen));
    label.textContent = isOpen ? 'Menüyü kapat' : 'Menüyü aç';
    header.toggleAttribute('data-menu-open', isOpen);
    document.documentElement.style.overflow = isOpen ? 'hidden' : '';
    update();
    if (isOpen) {
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
    } else {
      menu.classList.remove('is-open');
      setTimeout(() => {
        if (!menu.classList.contains('is-open')) menu.hidden = true;
      }, 400);
    }
  };
  toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });
</script>

<style>
  .site-header {
    --tone-t: 0.2s;
    /* dark tone: over the 3D stage and dark sections */
    --nav-fg: #fff;
    --nav-muted: rgba(255, 255, 255, 0.9);
    --nav-hover: rgba(255, 255, 255, 0.1);
    /* tinted enough that links keep ≥4.5:1 over bright photos */
    --nav-glass: rgba(8, 14, 34, 0.34);
    --nav-glass-scrolled: rgba(8, 14, 34, 0.64);
    --nav-edge: rgba(255, 255, 255, 0.16);
    --nav-shine: rgba(255, 255, 255, 0.1);
    --nav-hull: #fff;
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding-top: 14px;
    color: var(--nav-fg);
  }
  /* light tone: over the light sections (Services, Process) */
  .site-header[data-tone='light'] {
    --nav-fg: var(--c-ink);
    --nav-muted: rgba(10, 17, 40, 0.72);
    --nav-hover: rgba(10, 17, 40, 0.06);
    --nav-glass: rgba(255, 255, 255, 0.5);
    --nav-glass-scrolled: rgba(255, 255, 255, 0.62);
    --nav-edge: rgba(10, 17, 40, 0.12);
    --nav-shine: rgba(255, 255, 255, 0.75);
    --nav-hull: var(--c-navy);
  }

  /* Transparent frosted rectangle */
  .bar {
    position: relative;
    z-index: 2;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 10px 0 20px;
    margin-inline: -20px;
    border: 1px solid var(--nav-edge);
    border-radius: 14px;
    background: var(--nav-glass);
    box-shadow: inset 0 1px 0 var(--nav-shine);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    transition:
      background-color var(--tone-t) linear,
      border-color var(--tone-t) linear,
      box-shadow var(--tone-t) linear,
      color var(--tone-t) linear;
  }
  .site-header[data-scrolled] .bar {
    background: var(--nav-glass-scrolled);
    box-shadow:
      inset 0 1px 0 var(--nav-shine),
      0 18px 40px -24px rgba(0, 0, 0, 0.5);
  }
  .site-header[data-menu-open] .bar {
    background: rgba(8, 14, 34, 0.7);
  }

  /* cyan focus ring is too faint on the light glass */
  .site-header[data-tone='light'] :focus-visible {
    outline-color: var(--c-navy);
  }

  .brand {
    --mark-hull: var(--nav-hull);
    --mark-spark: var(--c-signal);
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    margin-right: auto;
  }
  .brand__mark {
    width: 50px;
    height: 45px;
  }
  .brand__word {
    display: flex;
    gap: 0.42em;
    font-stretch: 125%;
    font-weight: 560;
    font-size: 14.5px;
    letter-spacing: 0.16em;
  }
  .brand__a {
    color: var(--c-signal);
  }

  .nav ul {
    display: flex;
    gap: 4px;
    margin: 0;
  }
  .nav a {
    display: block;
    padding: 9px 14px;
    white-space: nowrap;
    border-radius: 9px;
    font-family: var(--f-display);
    font-size: 15.5px;
    font-weight: 560;
    text-decoration: none;
    color: var(--nav-muted);
    transition:
      color var(--tone-t) linear,
      background-color var(--tone-t) linear;
  }
  .nav a:hover {
    color: var(--nav-fg);
    background: var(--nav-hover);
  }
  .nav a[aria-current] {
    color: var(--nav-fg);
    background: var(--nav-hover);
  }

  .bar__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .bar__phone {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-display);
    font-size: 15.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    color: var(--nav-fg);
    transition: color var(--tone-t) linear;
  }
  .bar__phone :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--c-signal);
  }
  .bar__cta {
    min-height: 48px;
    padding: 0 22px;
    font-size: 15px;
  }

  .menu-toggle {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    color: var(--nav-fg);
    background: var(--nav-hover);
    border: 1px solid var(--nav-edge);
    border-radius: 10px;
    cursor: pointer;
    transition:
      color var(--tone-t) linear,
      background-color var(--tone-t) linear,
      border-color var(--tone-t) linear;
  }
  .menu-toggle :global(svg) {
    width: 22px;
    height: 22px;
  }
  .menu-toggle :global(.menu-toggle__close) {
    display: none;
  }
  .site-header[data-menu-open] :global(.menu-toggle__open) {
    display: none;
  }
  .site-header[data-menu-open] :global(.menu-toggle__close) {
    display: block;
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: calc(14px + 64px + 12px);
    background: var(--c-abyss);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .mobile-menu.is-open {
    opacity: 1;
  }
  .mobile-menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    padding-block: 16px 40px;
  }
  .mobile-menu__list {
    margin: 0;
  }
  .mobile-menu__list li {
    border-bottom: 1px solid var(--c-line-dark);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 45ms + 60ms);
  }
  .mobile-menu.is-open li {
    opacity: 1;
    transform: none;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 18px 0;
    text-decoration: none;
    font-family: var(--f-display);
    font-size: clamp(30px, 8.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .mobile-menu__list .numeral {
    min-width: 1.7em;
    font-size: 0.6em;
    font-style: italic;
    color: var(--c-signal);
  }
  .mobile-menu__contact {
    display: grid;
    gap: 8px;
    color: var(--c-mist);
  }
  .mobile-menu__phone {
    font-family: var(--f-display);
    font-size: 24px;
    font-weight: 650;
    color: #fff;
    text-decoration: none;
  }
  .mobile-menu__contact .btn {
    margin-top: 16px;
    color: #fff;
  }

  @media (max-width: 1300px) {
    .bar__phone {
      display: none;
    }
  }
  @media (max-width: 1120px) {
    .bar {
      gap: 20px;
    }
    .nav ul {
      gap: 0;
    }
    .nav a {
      padding-inline: 10px;
      font-size: 15px;
    }
  }
  @media (max-width: 980px) {
    .nav {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 640px) {
    .site-header {
      padding-top: 10px;
    }
    .bar {
      height: 60px;
      margin-inline: -10px;
      padding: 0 6px 0 12px;
      border-radius: 12px;
    }
    .bar__cta {
      display: none;
    }
    .brand__mark {
      width: 42px;
      height: 38px;
    }
    .brand__word {
      font-size: 12.5px;
    }
  }
</style>
