---
import { anchors, langOf } from '../i18n';
const lang = langOf(Astro.currentLocale);

const copy = {
  tr: {
    title: ['Geminin sorumluluğunu', 'taşıyanlar', 'için.'],
    lead: 'Bir arızanın maliyetini en iyi, o maliyeti üstlenenler bilir. Çalışma şeklimizi onların beklentisine göre kurduk.',
    roles: [
      { who: 'Armatörler ve gemi işletmecileri', need: 'Off-hire riskini azaltan, hızlı ve kayıtlı servis.' },
      { who: 'Teknik müdürler ve süperintendentler', need: 'Raporlanmış, izlenebilir, sürprizsiz işler. Bir sonraki sörvey için hazır kayıtlar.' },
      { who: 'Baş mühendisler ve kaptanlar', need: 'Makine dairesinin dilini konuşan, sahada hızlı karar veren bir ekip.' },
      { who: 'Tersaneler', need: 'Yeni inşa ve onarım projelerinde pano montajı, söküm ve devreye alma.' },
    ],
  },
  en: {
    title: ['For the people', 'responsible', 'for the ship.'],
    lead: 'Those who carry the cost of a fault understand it best. We built the way we work around what they expect.',
    roles: [
      { who: 'Shipowners and ship operators', need: 'Fast, documented service that cuts the risk of off-hire.' },
      { who: 'Technical managers and superintendents', need: 'Reported, traceable work with no surprises. Records ready for the next survey.' },
      { who: 'Chief engineers and masters', need: 'A team that speaks the engine room’s language and makes quick decisions on site.' },
      { who: 'Shipyards', need: 'Panel installation, removal and commissioning on newbuilding and repair projects.' },
    ],
  },
}[lang];
const roles = copy.roles;
---

<section class="audience" id={anchors.audience[lang]} aria-labelledby="audience-title">
  <div class="container audience__grid">
    <header class="audience__head">
      <h2 class="h2" id="audience-title" data-reveal>{copy.title[0]} <em>{copy.title[1]}</em> {copy.title[2]}</h2>
      <p class="lead" data-reveal style="--d:120">{copy.lead}</p>
    </header>

    <ul class="roles" role="list">
      {
        roles.map((r, i) => (
          <li class="role" data-reveal style={`--d:${i * 70}`}>
            <span class="role__lamp" aria-hidden="true" />
            <h3 class="role__who h3">{r.who}</h3>
            <p class="role__need">{r.need}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .audience {
    padding-block: clamp(96px, 12vw, 180px);
    background:
      radial-gradient(70% 60% at 100% 0%, rgba(34, 57, 143, 0.32), transparent 70%),
      var(--c-deep);
  }
  .audience__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 110px);
    align-items: start;
  }
  .audience__head {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }
  .audience__head .h2 {
    font-size: clamp(40px, 4.8vw, 76px);
  }
  .audience__head .h2 em {
    color: var(--c-signal);
  }
  .audience__head .lead {
    margin-top: 28px;
    color: #c9d3ea;
    max-width: 440px;
  }

  .roles {
    margin: 0;
    border-top: 1px solid var(--c-line-dark-2);
  }
  .role {
    position: relative;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: 18px;
    padding: 34px 8px 34px 0;
    border-bottom: 1px solid var(--c-line-dark-2);
    isolation: isolate;
  }
  .role::before {
    content: '';
    position: absolute;
    inset: 0 -20px;
    border-radius: var(--r-lg);
    z-index: -1;
    background: linear-gradient(90deg, rgba(43, 187, 229, 0.08), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }
  .role:hover::before {
    opacity: 1;
  }
  .role__lamp {
    width: 12px;
    height: 12px;
    margin-top: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--c-mist-2);
    transition:
      background-color 0.4s,
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .role:hover .role__lamp {
    background: var(--c-signal);
    border-color: var(--c-signal);
    box-shadow: 0 0 16px var(--c-signal);
  }
  .role__who {
    font-size: clamp(26px, 2.8vw, 42px);
  }
  .role__need {
    grid-column: 2;
    margin-top: 12px;
    max-width: 520px;
    color: var(--c-mist);
    font-size: 17px;
  }

  @media (max-width: 1080px) {
    .audience__grid {
      grid-template-columns: 1fr;
    }
    .audience__head {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .role {
      grid-template-columns: 20px minmax(0, 1fr);
      column-gap: 12px;
      padding: 26px 0;
    }
    .role__lamp {
      width: 10px;
      height: 10px;
      margin-top: 9px;
    }
    .role__need {
      font-size: 16px;
    }
  }
</style>
