---
// Phone, e-mail, Instagram and LinkedIn on a bar fixed to the middle of the right edge, on
// every page. It steps aside while the request form or the footer (which list the
// same links) is on screen.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { langOf, ui } from '../i18n';
const lang = langOf(Astro.currentLocale);
const t = ui[lang].rail;
const phone = site.phones[0];
const instagram = site.social.instagram;
const handle = instagram && `@${new URL(instagram).pathname.replaceAll('/', '')}`;
const linkedin = site.social.linkedin;
---

<aside class="rail" aria-label={t.label} data-rail>
  <ul role="list" class="rail__list">
    <li>
      <a class="rail__link" href={phone.href}>
        <Icon name="phone" />
        <span class="rail__tip"><span class="visually-hidden">{t.phone}: </span>{phone.display}</span>
      </a>
    </li>
    <li>
      <a class="rail__link" href={`mailto:${site.email}`}>
        <Icon name="mail" />
        <span class="rail__tip"><span class="visually-hidden">{t.email}: </span>{site.email}</span>
      </a>
    </li>
    {
      instagram && (
        <li>
          <a class="rail__link" href={instagram} target="_blank" rel="noopener">
            <Icon name="instagram" />
            <span class="rail__tip">
              <span class="visually-hidden">{t.instagram}: </span>
              {handle}
            </span>
          </a>
        </li>
      )
    }
    {
      linkedin && (
        <li>
          <a class="rail__link" href={linkedin} target="_blank" rel="noopener">
            <Icon name="linkedin" />
            <span class="rail__tip">LinkedIn</span>
          </a>
        </li>
      )
    }
  </ul>
</aside>

<script>
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const form = document.querySelector('[data-request]');
  const footer = document.querySelector('footer');
  if (rail && 'IntersectionObserver' in window) {
    const seen = new Set<Element>();
    const track = (e: IntersectionObserverEntry) => {
      if (e.isIntersecting) seen.add(e.target);
      else seen.delete(e.target);
      rail.toggleAttribute('data-hidden', seen.size > 0);
    };
    if (form) new IntersectionObserver((es) => es.forEach(track), { threshold: 0.15 }).observe(form);
    if (footer) new IntersectionObserver((es) => es.forEach(track), { rootMargin: '0px 0px -60px 0px' }).observe(footer);
  }
</script>

<style>
  .rail {
    --size: 62px;
    --icon: 27px;
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 90;
    transform: translateY(-50%);
    transition:
      transform 0.5s var(--ease-out),
      visibility 0s;
  }
  .rail[data-hidden] {
    transform: translate(110%, -50%);
    visibility: hidden;
    transition:
      transform 0.5s var(--ease-out),
      visibility 0s 0.5s;
  }
  /* soft cyan halo behind the bar */
  .rail::before {
    content: '';
    position: absolute;
    inset: 10px 0 10px 10px;
    z-index: -1;
    border-radius: 22px 0 0 22px;
    background: var(--c-signal);
    filter: blur(18px);
    opacity: 0.45;
  }
  .rail__list {
    display: grid;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    border-radius: 22px 0 0 22px;
    background: var(--c-signal);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.28),
      0 22px 44px -16px rgba(0, 0, 0, 0.55);
  }
  .rail__list li + li {
    border-top: 1px solid rgba(8, 17, 42, 0.16);
  }
  .rail__link {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    color: var(--c-abyss);
  }
  .rail__link :global(svg) {
    width: var(--icon);
    height: var(--icon);
    transition: transform 0.3s var(--ease-out);
  }
  .rail__link:hover :global(svg),
  .rail__link:focus-visible :global(svg) {
    transform: scale(1.14);
  }
  .rail__link:focus-visible {
    outline: 2px solid var(--c-abyss);
    outline-offset: -6px;
    border-radius: 12px;
  }
  /* the number, address or handle slides out to the left on hover and focus */
  .rail__tip {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    padding: 11px 18px;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-pill);
    background: rgba(6, 12, 30, 0.92);
    box-shadow: 0 16px 34px -14px rgba(0, 0, 0, 0.6);
    color: #fff;
    font-family: var(--f-display);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(10px, -50%);
    transition:
      opacity 0.2s,
      transform 0.3s var(--ease-out);
  }
  .rail__link:hover .rail__tip,
  .rail__link:focus-visible .rail__tip {
    opacity: 1;
    transform: translate(0, -50%);
  }
  /* touch screens: no hover, so keep the text for screen readers only */
  @media (hover: none) {
    .rail__tip {
      width: 1px;
      height: 1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
  @media (max-width: 760px) {
    .rail {
      --size: 52px;
      --icon: 24px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* slides in from the edge once the page has settled, then the halo breathes */
    .rail {
      animation: rail-in 0.8s var(--ease-out) 0.9s backwards;
    }
    .rail::before {
      animation: rail-glow 3.2s ease-in-out infinite;
    }
  }
  @keyframes rail-in {
    from {
      transform: translate(110%, -50%);
    }
  }
  @keyframes rail-glow {
    50% {
      opacity: 0.8;
    }
  }
</style>
