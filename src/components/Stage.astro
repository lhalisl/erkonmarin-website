---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { photos } from '../data/photos';

// Shown instead of the 3D render when the scene can't run (no WebGL, software GPU, Data Saver)
const realPoster = await getImage({ src: photos.msb.src, width: 2000, format: 'webp', quality: 78 });

const chapters = [
  {
    id: 'sistemler',
    title: ['Kontrol', 'odası'],
    text: 'Alarm ve izleme konsolundaki bir uyarı, çoğu zaman sahadaki bir arızanın ilk işaretidir. Sinyali kaynağına kadar izler, arızayı yerinde tespit ederiz.',
    items: ['Alarm ve izleme konsolları', 'Sinyal ve kablaj takibi', 'Konsol ekipmanlarının bakımı'],
  },
  {
    id: 'sistem-msb',
    title: ['Ana dağıtım', 'panosu'],
    text: 'Geminin bütün enerjisi buradan geçer. Jeneratör, bara ve dağıtım hücrelerinde arıza tespiti ve bakım, enerjiyi kesintisiz tutma disipliniyle yapılır.',
    items: ['Jeneratör ve senkronizasyon panoları', 'Hava ve kompakt devre kesiciler (ACB / MCCB)', 'Ölçü, koruma ve kontrol devreleri'],
  },
  {
    id: 'sistem-otomasyon',
    title: ['Otomasyon', 'panoları'],
    text: 'PLC’den röleye, klemensten operatör paneline: otomasyon arızalarını şema üzerinden adım adım izler, gereken parçayı değiştirir, sistemi yeniden devreye alırız.',
    items: ['PLC ve I/O modülleri', 'Röle, kontaktör ve starter devreleri', 'Operatör panelleri (HMI)'],
  },
  {
    id: 'sistem-montaj',
    title: ['Montaj ve', 'demontaj'],
    text: 'Yeni panonun montajından eski sistemin sökümüne kadar işi uçtan uca üstleniriz. Her bağlantı etiketlenir, her adım kayda geçer.',
    items: ['Pano montajı ve devreye alma', 'Kontrollü söküm ve etiketleme', 'Test ve teslim raporu'],
  },
];
---

<section class="stage" data-stage aria-labelledby="hero-title" style={`--real-poster:url(${realPoster.src})`}>
  <div class="stage__viewport" data-stage-viewport>
    <div class="stage__poster" aria-hidden="true"></div>
    <canvas class="stage__canvas" data-stage-canvas aria-hidden="true"></canvas>
    <div class="stage__scrim" aria-hidden="true"></div>
    <div class="stage__annotations" data-stage-annotations aria-hidden="true"></div>

    <div class="stage__bottom container" aria-hidden="true">
      <div class="hud" data-stage-hud>
        <div class="hud__head">
          <span>Ana bara</span>
          <span class="hud__live"><span class="lamp"></span>DG1 · DG2</span>
        </div>
        <div class="hud__vals">
          <span><b data-hud="v">440</b>V</span>
          <span><b data-hud="hz">60.0</b>Hz</span>
          <span><b data-hud="load">62</b>%</span>
        </div>
        <div class="hud__bar"><span data-hud="bar"></span></div>
      </div>
    </div>
  </div>

  <div class="stage__track">
    <div class="step step--hero" data-step id="giris">
      <div class="container">
        <div class="hero">
          <h1 class="hero__title display" id="hero-title">
            <span class="visually-hidden">Erkon Marin, gemi elektrik ve otomasyon servisi. </span>
            <span class="hero__line">Ana panoda</span>
            <em class="hero__line">tahmine</em>
            <span class="hero__line">yer yok.</span>
          </h1>
          <p class="hero__lead">
            Kontrol odası, MSB ve tüm otomasyon panolarında arıza tespiti, bakım, montaj ve demontaj. Geminiz rıhtımda beklerken
            her saatin değerini bilen bir ekiple.
          </p>
          <div class="hero__actions">
            <a class="btn btn--signal" href="#talep">
              <span>Servis talebi oluşturun</span>
              <Icon name="arrow" />
            </a>
            <a class="btn btn--ghost hero__call" href={site.phones[0].href}>
              <Icon name="phone" />
              <span>{site.phones[0].display}</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {
      chapters.map((c) => (
        <article class="step step--chapter" data-step id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="container">
            <div class="chapter">
              <h2 class="chapter__title h2" id={`${c.id}-title`}>
                {c.title[0]} <em>{c.title[1]}</em>
              </h2>
              <p class="chapter__text">{c.text}</p>
              <ul class="chapter__list" role="list">
                {c.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { initStage } from '../scripts/stage/ui';
  initStage();
</script>

<style>
  .stage {
    position: relative;
    background: #070d22;
  }

  .stage__viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    overflow: hidden;
    z-index: 0;
  }

  .stage__poster,
  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 1.4s var(--ease-out);
  }
  .stage__poster {
    background:
      url('/media/stage-poster.webp') right center / cover no-repeat,
      radial-gradient(60% 70% at 72% 55%, #18295a 0%, #070d22 70%);
  }
  .stage__canvas {
    opacity: 0;
  }
  .stage__viewport:global(.is-live) .stage__canvas {
    opacity: 1;
  }
  .stage__viewport:global(.is-live) .stage__poster {
    opacity: 0;
  }

  .stage__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(5, 10, 25, 0.94) 0%, rgba(5, 10, 25, 0.72) 32%, rgba(5, 10, 25, 0) 58%),
      linear-gradient(0deg, rgba(5, 10, 25, 0.85) 0%, rgba(5, 10, 25, 0) 22%),
      linear-gradient(180deg, rgba(5, 10, 25, 0.7) 0%, rgba(5, 10, 25, 0) 20%);
  }

  /* Labels pinned to equipment (positioned by the engine) */
  .stage__annotations {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stage__annotations :global(.anno) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    will-change: transform, opacity;
  }
  .stage__annotations :global(.anno__dot) {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--c-signal);
    box-shadow: 0 0 16px rgba(43, 187, 229, 0.55);
  }
  .stage__annotations :global(.anno__dot)::after {
    content: '';
    position: absolute;
    inset: 3.5px;
    border-radius: 50%;
    background: var(--c-signal);
  }
  .stage__annotations :global(.anno__line) {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, rgba(43, 187, 229, 0.2), var(--c-signal));
    transform-origin: 0 0;
    transform: rotate(-34deg);
  }
  .stage__annotations :global(.anno__body) {
    position: absolute;
    left: 53px;
    top: -64px;
    display: grid;
    gap: 1px;
    padding: 10px 18px 11px;
    white-space: nowrap;
    background: rgba(6, 12, 30, 0.82);
    border: 1px solid rgba(43, 187, 229, 0.32);
    border-radius: var(--r-md);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    line-height: 1.3;
  }
  .stage__annotations :global(.anno__body b) {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 15px;
    color: #fff;
  }
  .stage__annotations :global(.anno__body span) {
    font-size: 13px;
    color: var(--c-mist);
  }
  .stage__annotations :global(.anno[data-side='l'] .anno__line) {
    transform: rotate(-146deg);
  }
  .stage__annotations :global(.anno[data-side='l'] .anno__body) {
    left: auto;
    right: 53px;
  }

  /* Live bus readout */
  .stage__bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    margin-inline: auto;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
  }
  .hud {
    width: 310px;
    padding: 22px 28px 26px;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-xl);
    background: rgba(6, 12, 30, 0.7);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, 0.7);
    color: var(--c-mist);
    font-size: 13px;
  }
  .hud__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hud__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: rgba(62, 224, 143, 0.1);
    color: #fff;
    font-size: 12px;
  }
  .hud__live .lamp {
    width: 6px;
    height: 6px;
  }
  .hud__vals {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
  }
  .hud__vals span {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
  }
  .hud__vals b {
    font-family: var(--f-display);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .hud__bar {
    position: relative;
    height: 4px;
    margin-top: 14px;
    border-radius: var(--r-pill);
    background: var(--c-line-dark-2);
    overflow: hidden;
  }
  .hud__bar span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c-signal-dim), var(--c-signal));
    transform-origin: left;
    transform: scaleX(0.62);
    transition: transform 0.3s linear;
  }

  /* Scrolling copy */
  .stage__track {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .step {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 32px) 120px;
  }
  .step > .container {
    width: 100%;
  }
  .hero,
  .chapter {
    pointer-events: auto;
    opacity: var(--vis, 1);
    transform: translateY(calc((1 - var(--vis, 1)) * 26px));
    will-change: opacity, transform;
  }

  .hero {
    max-width: 720px;
  }
  .hero__title {
    font-size: clamp(56px, min(7.4vw, 12vh), 128px);
  }
  .hero__line {
    display: block;
  }
  .hero__title em {
    color: var(--c-signal);
    line-height: 0.9;
  }
  .hero__lead {
    max-width: 520px;
    margin-top: 32px;
    color: #c9d3ea;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .hero__call {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .chapter {
    max-width: 500px;
  }
  .chapter__title {
    font-size: clamp(44px, 5vw, 80px);
  }
  .chapter__title em {
    color: var(--c-signal-hi);
  }
  .chapter__text {
    margin-top: 24px;
    color: #c9d3ea;
    font-size: 18px;
    text-wrap: pretty;
  }
  .chapter__list {
    margin-top: 28px;
    border-top: 1px solid var(--c-line-dark-2);
  }
  .chapter__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: 15.5px;
    color: #e6ecf8;
  }
  .chapter__list li::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 10px var(--c-signal);
  }

  /* No WebGL / data saver: the real switchboard photo instead of the render */
  .stage:global(.is-static) .stage__canvas {
    display: none;
  }
  /* the bus readout belongs to the simulated scene, not to a photo */
  .stage:global(.is-static) .stage__bottom {
    display: none;
  }
  .stage:global(.is-static) .stage__poster {
    background:
      var(--real-poster) 62% center / cover no-repeat,
      #070d22;
  }

  @media (max-width: 959px) {
    .stage__scrim {
      background:
        linear-gradient(0deg, rgba(5, 10, 25, 0.98) 0%, rgba(5, 10, 25, 0.9) 44%, rgba(5, 10, 25, 0.62) 62%, rgba(5, 10, 25, 0) 80%),
        linear-gradient(180deg, rgba(5, 10, 25, 0.8) 0%, rgba(5, 10, 25, 0) 22%);
    }
    .stage__poster {
      background-position: 70% 20%;
    }
    .step {
      align-items: flex-end;
      padding-bottom: 72px;
    }
    .stage__bottom,
    .stage__annotations {
      display: none;
    }
    .hero__title {
      font-size: clamp(48px, 13vw, 84px);
    }
    .hero__lead {
      margin-top: 22px;
    }
    .hero__actions {
      margin-top: 28px;
    }
    .chapter__title {
      font-size: clamp(38px, 10vw, 60px);
    }
    .chapter__text {
      font-size: 16px;
    }
    .chapter__list li {
      padding: 10px 0;
      font-size: 14.5px;
    }
  }

  /* the mobile dock sits over the bottom of the viewport */
  @media (max-width: 760px) {
    .step {
      padding-bottom: 108px;
    }
  }

  @media (max-width: 520px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
