---
import { accent } from '../lib/utils';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { photos } from '../data/photos';
import { anchors, langOf, ui } from '../i18n';
import { STAGE_CHECK } from '../scripts/inline.mjs';

// Shown instead of the 3D render when the scene can't run (no WebGL, software GPU, Data Saver)
const realPoster = await getImage({ src: photos.msb.src, width: 2000, format: 'webp', quality: 78 });

const lang = langOf(Astro.currentLocale);

const copy = {
  tr: {
    hidden: 'Erkon Marin, gemi elektrik ve otomasyon servisi. ',
    title: ['Ana panoda', 'tahmine', 'yer yok.'],
    lead: 'Kontrol odası, MSB ve tüm otomasyon panolarında arıza tespiti, bakım, montaj ve demontaj. Geminiz rıhtımda beklerken her saatin değerini bilen bir ekiple.',
  },
  en: {
    hidden: 'Erkon Marin, marine electrical and automation service. ',
    title: ['On the MSB,', 'guesswork', 'has no place.'],
    lead: 'Fault diagnosis, maintenance, installation and removal across the control room, the MSB and every automation panel, by a team that knows what each hour at the quay costs while your ship waits.',
  },
}[lang];

const chapters = {
  tr: [
    {
      id: anchors.systems.tr,
      title: ['Kontrol', 'odası'],
      text: 'Alarm ve izleme konsolundaki bir uyarı, çoğu zaman sahadaki bir arızanın ilk işaretidir. Sinyali kaynağına kadar izler, arızayı yerinde tespit ederiz.',
      items: ['Alarm ve izleme konsolları', 'Sinyal ve kablaj takibi', 'Konsol ekipmanlarının bakımı'],
    },
    {
      id: 'sistem-msb',
      title: ['Ana dağıtım', 'panosu'],
      text: 'Geminin bütün enerjisi buradan geçer. Jeneratör, bara ve dağıtım hücrelerinde arıza tespiti ve bakım, enerjiyi kesintisiz tutma disipliniyle yapılır.',
      items: ['Jeneratör ve senkronizasyon panoları', 'Hava ve kompakt devre kesiciler (ACB / MCCB)', 'Ölçü, koruma ve kontrol devreleri'],
    },
    {
      id: 'sistem-otomasyon',
      title: ['Otomasyon', 'panoları'],
      text: 'PLC’den röleye, klemensten operatör paneline: otomasyon arızalarını şema üzerinden adım adım izler, gereken parçayı değiştirir, sistemi yeniden devreye alırız.',
      items: ['PLC ve I/O modülleri', 'Röle, kontaktör ve starter devreleri', 'Operatör panelleri (HMI)'],
    },
    {
      id: 'sistem-montaj',
      title: ['Montaj ve', 'demontaj'],
      text: 'Yeni panonun montajından eski sistemin sökümüne kadar işi uçtan uca üstleniriz. Her bağlantı etiketlenir, her adım kayda geçer.',
      items: ['Pano montajı ve devreye alma', 'Kontrollü söküm ve etiketleme', 'Test ve teslim raporu'],
    },
  ],
  en: [
    {
      id: anchors.systems.en,
      title: ['Control', 'room'],
      text: 'An alert on the alarm and monitoring console is often the first sign of a fault out in the plant. We trace the signal back to its source and pinpoint the fault on site.',
      items: ['Alarm and monitoring consoles', 'Signal and wiring tracing', 'Maintenance of console equipment'],
    },
    {
      id: 'system-msb',
      title: ['Main', 'switchboard'],
      text: 'All of the ship’s power passes through here. Fault diagnosis and maintenance on generator, busbar and distribution sections are done with the discipline of keeping the power on.',
      items: ['Generator and synchronising panels', 'Air and moulded-case circuit breakers (ACB / MCCB)', 'Metering, protection and control circuits'],
    },
    {
      id: 'system-automation',
      title: ['Automation', 'panels'],
      text: 'From PLC to relay, from terminal block to operator panel: we trace automation faults step by step on the drawings, replace the part that needs replacing and bring the system back into service.',
      items: ['PLC and I/O modules', 'Relay, contactor and starter circuits', 'Operator panels (HMI)'],
    },
    {
      id: 'system-installation',
      title: ['Installation and', 'removal'],
      text: 'From fitting a new panel to removing an old system, we take on the job end to end. Every connection is labelled and every step is recorded.',
      items: ['Panel installation and commissioning', 'Controlled removal and labelling', 'Test and handover report'],
    },
  ],
}[lang];
---

<section class="stage" data-stage aria-labelledby="hero-title" style={`--real-poster:url(${realPoster.src})`}>
  <script is:inline set:html={STAGE_CHECK} />
  <div class="stage__viewport" data-stage-viewport>
    <div class="stage__poster" aria-hidden="true"></div>
    <canvas class="stage__canvas" data-stage-canvas aria-hidden="true"></canvas>
    <div class="stage__scrim" aria-hidden="true"></div>
    <div class="stage__annotations" data-stage-annotations aria-hidden="true"></div>
  </div>

  <div class="stage__track">
    <div class="step step--hero" data-step id={anchors.intro[lang]}>
      <div class="container">
        <div class="hero">
          <h1 class="hero__title display" id="hero-title">
            <span class="visually-hidden">{copy.hidden}</span>
            <span class="hero__line">{copy.title[0]}</span>
            <em class={accent(copy.title[1], 'hero__line')}>{copy.title[1]}</em>
            <span class="hero__line">{copy.title[2]}</span>
          </h1>
          <p class="hero__lead">{copy.lead}</p>
          <div class="hero__actions">
            <a class="btn btn--signal" href={`#${anchors.request[lang]}`}>
              <span>{ui[lang].requestLong}</span>
              <Icon name="arrow" />
            </a>
            <a class="btn btn--ghost hero__call" href={site.phones[0].href}>
              <Icon name="phone" />
              <span>{site.phones[0].display}</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    {
      chapters.map((c) => (
        <article class="step step--chapter" data-step id={c.id} aria-labelledby={`${c.id}-title`}>
          <div class="container">
            <div class="chapter">
              <h2 class="chapter__title h2" id={`${c.id}-title`}>
                {c.title[0]} <em class={accent(c.title[1])}>{c.title[1]}</em>
              </h2>
              <p class="chapter__text">{c.text}</p>
              <ul class="chapter__list" role="list">
                {c.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  import { initStage } from '../scripts/stage/ui';
  initStage();
</script>

<style>
  .stage {
    position: relative;
    background: var(--c-abyss);
  }

  .stage__viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    margin-bottom: -100vh;
    margin-bottom: -100svh;
    overflow: hidden;
    z-index: 0;
  }

  .stage__poster,
  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 1.4s var(--ease-out);
  }
  :global(html:not([data-stage-static])) .stage__poster {
    background:
      url('/media/stage-poster.webp') right center / cover no-repeat,
      radial-gradient(60% 70% at 72% 55%, #18295a 0%, #08112a 70%);
  }
  .stage__canvas {
    opacity: 0;
  }
  .stage__viewport:global(.is-live) .stage__canvas {
    opacity: 1;
  }
  .stage__viewport:global(.is-live) .stage__poster {
    opacity: 0;
  }

  .stage__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(8, 17, 42, 0.94) 0%, rgba(8, 17, 42, 0.72) 32%, rgba(8, 17, 42, 0) 58%),
      linear-gradient(0deg, rgba(8, 17, 42, 0.85) 0%, rgba(8, 17, 42, 0) 22%),
      linear-gradient(180deg, var(--scrim-top, rgba(8, 17, 42, 0.7)) 0%, rgba(8, 17, 42, 0) var(--scrim-top-end, 20%));
  }

  /* Labels pinned to equipment (positioned by the engine) */
  .stage__annotations {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .stage__annotations :global(.anno) {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    will-change: transform, opacity;
  }
  .stage__annotations :global(.anno__dot) {
    position: absolute;
    left: -8px;
    top: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--c-signal);
    box-shadow: 0 0 16px rgba(43, 187, 229, 0.55);
  }
  .stage__annotations :global(.anno__dot)::after {
    content: '';
    position: absolute;
    inset: 3.5px;
    border-radius: 50%;
    background: var(--c-signal);
  }
  .stage__annotations :global(.anno__line) {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, rgba(43, 187, 229, 0.2), var(--c-signal));
    transform-origin: 0 0;
    transform: rotate(-34deg);
  }
  .stage__annotations :global(.anno__body) {
    position: absolute;
    left: 53px;
    top: -64px;
    display: grid;
    gap: 1px;
    padding: 10px 18px 11px;
    white-space: nowrap;
    background: rgba(6, 12, 30, 0.82);
    border: 1px solid rgba(43, 187, 229, 0.32);
    border-radius: var(--r-md);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    line-height: 1.3;
  }
  .stage__annotations :global(.anno__body b) {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 15px;
    color: #fff;
  }
  .stage__annotations :global(.anno__body span) {
    font-size: 13px;
    color: var(--c-mist);
  }
  .stage__annotations :global(.anno[data-side='l'] .anno__line) {
    transform: rotate(-146deg);
  }
  .stage__annotations :global(.anno[data-side='l'] .anno__body) {
    left: auto;
    right: 53px;
  }

  /* Scrolling copy */
  .stage__track {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .step {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 32px) 120px;
  }
  .step > .container {
    width: 100%;
  }
  .hero,
  .chapter {
    pointer-events: auto;
    opacity: var(--vis, 1);
    transform: translateY(calc((1 - var(--vis, 1)) * 26px));
    will-change: opacity, transform;
  }

  .hero {
    max-width: 720px;
  }
  .hero__title {
    font-size: clamp(56px, min(7.4vw, 12vh), 128px);
  }
  .hero__line {
    display: block;
  }
  .hero__title em {
    color: var(--c-signal);
    line-height: 0.9;
  }
  .hero__lead {
    max-width: 520px;
    margin-top: 32px;
    color: #c9d3ea;
    font-size: clamp(17px, 1.35vw, 20px);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }
  .hero__call {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .chapter {
    max-width: 500px;
  }
  .chapter__title {
    font-size: clamp(40px, 4.4vw, 70px);
  }
  .chapter__title em {
    color: var(--c-signal-hi);
  }
  .chapter__text {
    margin-top: 24px;
    color: #c9d3ea;
    font-size: 18px;
    text-wrap: pretty;
  }
  .chapter__list {
    margin-top: 28px;
    border-top: 1px solid var(--c-line-dark-2);
  }
  .chapter__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-dark);
    font-size: 15.5px;
    color: #e6ecf8;
  }
  .chapter__list li::before {
    content: '';
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 10px var(--c-signal);
  }

  /* No 3D (decided before paint, or the engine bailed out): the real switchboard photo */
  :global(html[data-stage-static]) .stage,
  .stage:global(.is-static) {
    /* darker top band so the nav stays legible over the bright photo */
    --scrim-top: rgba(8, 17, 42, 0.9);
    --scrim-top-end: 30%;
  }
  :global(html[data-stage-static]) .stage__canvas,
  .stage:global(.is-static) .stage__canvas {
    display: none;
  }
  :global(html[data-stage-static]) .stage__poster,
  .stage:global(.is-static) .stage__poster {
    background:
      var(--real-poster) 62% center / cover no-repeat,
      #08112a;
  }

  @media (max-width: 959px) {
    .stage__scrim {
      background:
        linear-gradient(0deg, rgba(8, 17, 42, 0.98) 0%, rgba(8, 17, 42, 0.9) 44%, rgba(8, 17, 42, 0.62) 62%, rgba(8, 17, 42, 0) 80%),
        linear-gradient(180deg, var(--scrim-top, rgba(8, 17, 42, 0.8)) 0%, rgba(8, 17, 42, 0) var(--scrim-top-end, 22%));
    }
    .stage__poster {
      background-position: 70% 20%;
    }
    .step {
      align-items: flex-end;
      padding-bottom: 72px;
    }
    .stage__annotations {
      display: none;
    }
    .hero__title {
      font-size: clamp(48px, 13vw, 84px);
    }
    .hero__lead {
      margin-top: 22px;
    }
    .hero__actions {
      margin-top: 28px;
    }
    .chapter__title {
      font-size: clamp(38px, 10vw, 60px);
    }
    .chapter__text {
      font-size: 16px;
    }
    .chapter__list li {
      padding: 10px 0;
      font-size: 14.5px;
    }
  }

  /* the mobile dock sits over the bottom of the viewport */
  @media (max-width: 760px) {
    .step {
      padding-bottom: 108px;
    }
  }

  @media (max-width: 520px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
