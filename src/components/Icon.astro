---
interface Props {
  name: 'arrow' | 'arrow-down' | 'arrow-up-right' | 'phone' | 'whatsapp' | 'menu' | 'close' | 'clock' | 'pin' | 'mail' | 'instagram' | 'linkedin';
  class?: string;
}
const { name, class: className } = Astro.props;
const cls = [name === 'arrow' ? 'arrow' : '', className].filter(Boolean).join(' ');
---

{
  name === 'arrow' && (
    <svg class={cls} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 12h15m0 0-6-6m6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
    </svg>
  )
}
{
  name === 'arrow-down' && (
    <svg class={cls} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v15m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" />
    </svg>
  )
}
{
  name === 'phone' && (
    <svg class={cls} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M5.2 3.5h3.3l1.7 4.3-2.2 1.5a11.3 11.3 0 0 0 6.7 6.7l1.5-2.2 4.3 1.7v3.3a1.7 1.7 0 0 1-1.8 1.7A16.6 16.6 0 0 1 3.5 5.3a1.7 1.7 0 0 1 1.7-1.8Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      />
    </svg>
  )
}
