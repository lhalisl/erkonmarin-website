---
import { langOf } from '../i18n';
// A sine trace on an oscilloscope graticule: AC waveform and sea swell in one line.
const W = 1200;
const H = 240;
const periods = 4;
const pts: string[] = [];
for (let i = 0; i <= 480; i++) {
  const x = (i / 480) * W;
  const y = H / 2 - Math.sin((i / 480) * Math.PI * 2 * periods) * (H * 0.32);
  pts.push(`${x.toFixed(1)},${y.toFixed(1)}`);
}
const wave = `M${pts.join(' L')}`;

const lang = langOf(Astro.currentLocale);
const copy = {
  tr: {
    title: ['Rıhtımda geçen her saatin bir', 'bedeli', 'var.'],
    lead: 'Bu yüzden arızaya ölçü aletiyle gireriz, tahminle değil. Ne bulduğumuzu gösterir, ne yaptığımızı raporlarız. Geminiz planladığınız saatte yola çıkar.',
    principles: [
      ['Ölç', 'Varsayım değil, ölçüm.'],
      ['Bul', 'Kök nedene kadar in.'],
      ['Belgele', 'Her adımı kayda geçir.'],
    ],
  },
  en: {
    title: ['Every hour at the quay comes at a', 'cost', '.'],
    lead: 'That’s why we approach a fault with a meter, not a guess. We show you what we found and report what we did. Your ship sails at the hour you planned.',
    principles: [
      ['Measure', 'Measurement, not assumption.'],
      ['Find', 'Get down to the root cause.'],
      ['Document', 'Record every step.'],
    ],
  },
}[lang];
---

<section class="statement" aria-labelledby="statement-title">
  <div class="scope" aria-hidden="true">
    <div class="scope__grid"></div>
    <svg class="scope__trace" viewBox={`0 0 ${W * 2} ${H}`} preserveAspectRatio="none">
      <g class="scope__wave">
        <path d={wave} />
        <path d={wave} transform={`translate(${W} 0)`} />
      </g>
    </svg>
  </div>

  <div class="container statement__inner">
    <h2 class="statement__big display" id="statement-title" data-reveal>
      {copy.title[0]} <em>{copy.title[1]}</em>{lang === 'tr' ? ' ' : ''}{copy.title[2]}
    </h2>
    <div class="statement__cols">
      <p class="lead" data-reveal style="--d:120">{copy.lead}</p>
      <ol class="principles" role="list">
        {
          copy.principles.map(([word, line], i) => (
            <li data-reveal style={`--d:${160 + i * 80}`}>
              <span class="numeral">{String(i + 1).padStart(2, '0')}</span>
              <b>{word}</b>
              <span>{line}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .statement {
    position: relative;
    overflow: hidden;
    padding-block: clamp(110px, 14vw, 200px);
    background: var(--c-abyss);
    isolation: isolate;
  }

  .scope {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .scope__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(143, 180, 255, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(143, 180, 255, 0.07) 1px, transparent 1px);
    background-size: calc(100% / 10) calc(100% / 8);
    mask-image: radial-gradient(90% 80% at 50% 50%, #000 40%, transparent 100%);
  }
  .scope__grid::before,
  .scope__grid::after {
    content: '';
    position: absolute;
    background: rgba(143, 180, 255, 0.16);
  }
  .scope__grid::before {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .scope__grid::after {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
  }
  .scope__trace {
    position: absolute;
    left: 0;
    top: 50%;
    width: 200%;
    height: 56%;
    transform: translateY(-50%);
    overflow: visible;
  }
  .scope__wave {
    animation: sweep 9s linear infinite;
  }
  .scope__wave path {
    fill: none;
    stroke: var(--c-signal);
    stroke-width: 2.4;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 6px rgba(43, 187, 229, 0.9)) drop-shadow(0 0 22px rgba(43, 187, 229, 0.45));
    opacity: 0.55;
  }
  @keyframes sweep {
    to {
      transform: translateX(-1200px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scope__wave {
      animation: none;
    }
  }

  .statement__big {
    max-width: 14ch;
    font-size: clamp(48px, 8vw, 140px);
  }
  .statement__big em {
    color: var(--c-signal);
  }
  .statement__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(48px, 6vw, 88px);
    align-items: start;
  }
  .statement__cols .lead {
    color: #c9d3ea;
    max-width: 460px;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--c-line-dark-2);
  }
  .principles li {
    display: grid;
    gap: 10px;
    padding: 22px 20px 0 0;
  }
  .principles li + li {
    padding-left: 20px;
    border-left: 1px solid var(--c-line-dark);
  }
  .principles .numeral {
    font-size: 34px;
    font-style: italic;
    color: var(--c-signal);
  }
  .principles b {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(26px, 2.6vw, 38px);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .principles span:last-child {
    color: var(--c-mist);
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .statement__cols {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .principles {
      grid-template-columns: 1fr;
    }
    .principles li,
    .principles li + li {
      grid-template-columns: 40px 1fr;
      align-items: baseline;
      padding: 18px 0;
      border-left: 0;
      border-bottom: 1px solid var(--c-line-dark);
    }
    .principles span:last-child {
      grid-column: 2;
    }
  }
</style>
