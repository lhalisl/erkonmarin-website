---
import Icon from './Icon.astro';
import { site, nav, whatsappLink, mapsLink, requestHref } from '../data/site';
import { services, serviceHref } from '../data/services';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <a class="footer__brand" href="/" aria-label="Erkon Marin, ana sayfa">
        <svg class="footer__mark" aria-hidden="true"><use href="#erkon-mark"></use></svg>
        <span class="footer__word" aria-hidden="true"><span>ERKON</span> MARİN</span>
      </a>
      <p class="footer__pitch">
        Gemi elektrik ve otomasyon sistemlerinde arıza tespiti, bakım, montaj ve demontaj.
      </p>
      <a class="btn btn--signal" href={requestHref(Astro.url.pathname)}>
        <span>Servis talebi</span>
        <Icon name="arrow" />
      </a>
    </div>

    <div class="footer__grid">
      <div>
        <p class="footer__h">Telefon</p>
        {
          site.phones.map((p) => (
            <a class="footer__phone" href={p.href}>
              {p.display}
            </a>
          ))
        }
      </div>
      <div>
        <p class="footer__h">Ofis</p>
        <address class="footer__addr">
          <a href={mapsLink} target="_blank" rel="noopener">
            {site.address.lines.map((l) => <span>{l}</span>)}
          </a>
        </address>
        <p class="footer__hours">Pazartesi – Cuma<br />10:00 – 18:00</p>
      </div>
      <div>
        <p class="footer__h">Mesaj</p>
        <a class="footer__link" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp</a>
        <a class="footer__link" href={`mailto:${site.email}`}>{site.email}</a>
        {
          socials.map(([name, url]) => (
            <a class="footer__link" href={url} target="_blank" rel="noopener">
              {name === 'instagram' ? 'Instagram' : 'Facebook'}
            </a>
          ))
        }
      </div>
      <nav aria-label="Hizmetler">
        <p class="footer__h">Hizmetler</p>
        <ul role="list">
          {
            services.map((s) => (
              <li>
                <a class="footer__link" href={serviceHref(s)}>
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label="Alt menü">
        <p class="footer__h">Sayfa</p>
        <ul role="list">
          {
            nav.map((n) => (
              <li>
                <a class="footer__link" href={n.href}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer__base">
      <span>© {year} Erkon Marin</span>
      <span>Gemi elektrik ve otomasyon servisi</span>
      <a href="#top">Başa dön ↑</a>
    </div>
  </div>

  <svg class="footer__wake" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 86 C 240 70, 420 62, 720 70 S 1200 96, 1440 60" />
    <path d="M0 104 C 300 96, 560 84, 860 92 S 1260 110, 1440 88" />
  </svg>
</footer>

<style>
  .footer {
    position: relative;
    padding-top: clamp(80px, 9vw, 140px);
    background: var(--c-abyss);
    border-top: 1px solid var(--c-line-dark);
    overflow: hidden;
  }

  .footer__top {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 32px 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid var(--c-line-dark-2);
  }
  .footer__brand {
    --mark-hull: #fff;
    --mark-spark: var(--c-signal);
    display: inline-flex;
    align-items: center;
    gap: 18px;
    text-decoration: none;
  }
  .footer__mark {
    width: 92px;
    height: 84px;
  }
  .footer__word {
    font-stretch: 125%;
    font-weight: 560;
    font-size: 22px;
    letter-spacing: 0.16em;
  }
  .footer__word span {
    color: var(--c-signal);
  }
  .footer__pitch {
    max-width: 420px;
    color: var(--c-mist);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px;
    padding-block: 48px 64px;
  }
  .footer__h {
    margin-bottom: 14px;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--c-mist-2);
  }
  .footer__grid ul {
    margin: 0;
  }
  .footer__grid p:not(.footer__h) {
    color: #dfe6f6;
  }
  .footer__addr {
    font-style: normal;
  }
  .footer__addr a {
    display: grid;
    width: fit-content;
    color: #dfe6f6;
    line-height: 1.55;
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer__addr a:hover {
    color: var(--c-signal-hi);
  }
  .footer__hours {
    margin-top: 14px;
  }
  .footer__phone {
    display: block;
    width: fit-content;
    white-space: nowrap;
    font-family: var(--f-display);
    font-size: 19px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    line-height: 1.8;
  }
  .footer__link {
    display: block;
    width: fit-content;
    color: #dfe6f6;
    text-decoration: none;
    line-height: 1.9;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }
  .footer__link:hover,
  .footer__phone:hover {
    background-size: 100% 1px;
    color: var(--c-signal-hi);
  }

  .footer__base {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 26px 120px;
    border-top: 1px solid var(--c-line-dark);
    font-size: 14px;
    color: var(--c-mist-2);
  }
  .footer__base a {
    text-decoration: none;
    color: var(--c-mist);
  }
  .footer__base a:hover {
    color: #fff;
  }

  /* The logo's wake line, stretched across the page */
  .footer__wake {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 120px;
  }
  .footer__wake path {
    fill: none;
    stroke: var(--c-navy);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .footer__wake path + path {
    stroke: rgba(43, 187, 229, 0.35);
    stroke-width: 2;
  }

  @media (max-width: 980px) {
    .footer__top {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .footer__base {
      padding-bottom: 150px;
    }
  }
  @media (max-width: 460px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__mark {
      width: 64px;
      height: 58px;
    }
    .footer__word {
      font-size: 17px;
    }
  }
</style>
