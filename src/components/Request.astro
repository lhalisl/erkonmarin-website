---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site, whatsappLink } from '../data/site';
import { photos } from '../data/photos';

const kinds = [
  { value: 'Acil arıza · gemi bekliyor', label: 'Acil arıza', hint: 'Gemi bekliyor', urgent: true },
  { value: 'Planlı bakım', label: 'Planlı bakım', hint: 'Takvime göre' },
  { value: 'Montaj / demontaj projesi', label: 'Montaj · söküm', hint: 'Proje' },
];
const systems = ['Ana makine', 'Yardımcı makine · D/G', 'Seyir sistemleri', 'MSB / ana pano', 'Kontrol odası · otomasyon', 'Diğer'];

interface Props {
  /** Leave out the phone / hours / message list (the contact page shows it above the form). */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<section class="request" id="talep" aria-labelledby="request-title">
  <div class="container request__grid">
    <div class="request__intro">
      <h2 class="h2" id="request-title" data-reveal>Arızayı anlatın, <em>gerisini</em> bize bırakın.</h2>
      <p class="lead" data-reveal style="--d:120">
        Formu doldurun; talebiniz WhatsApp üzerinden doğrudan ekibimize ulaşsın. Acil durumlarda telefonla arayın.
      </p>

      {!compact && (
      <dl class="lines" data-reveal style="--d:220">
        <div class="lines__row">
          <dt class="flabel">Telefon</dt>
          <dd>
            {
              site.phones.map((p) => (
                <a class="lines__phone" href={p.href}>
                  {p.display}
                </a>
              ))
            }
          </dd>
        </div>
        <div class="lines__row">
          <dt class="flabel">Çalışma saatleri</dt>
          <dd>{site.hours.label}</dd>
        </div>
        <div class="lines__row">
          <dt class="flabel">WhatsApp</dt>
          <dd>
            <a class="lines__wa" href={whatsappLink()} target="_blank" rel="noopener">
              Doğrudan mesaj gönderin
              <Icon name="arrow" />
            </a>
          </dd>
        </div>
        <div class="lines__row">
          <dt class="flabel">E-posta</dt>
          <dd>
            <a class="lines__mail" href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
      </dl>
      )}

      <figure class="request__photo" data-reveal style="--d:280">
        <Image
          src={photos.gemi.src}
          alt={photos.gemi.alt}
          widths={[480, 800, 1080]}
          sizes="(max-width: 1080px) 0px, 40vw"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <form class="rq" data-request novalidate data-reveal style="--d:120">
      <fieldset class="rq__set">
        <legend class="flabel">Talep türü</legend>
        <div class="rq__chips">
          {
            kinds.map((k, i) => (
              <label class:list={['chip', { 'chip--urgent': k.urgent }]}>
                <input type="radio" name="kind" value={k.value} checked={i === 0} />
                <span class="chip__lamp" aria-hidden="true" />
                <span class="chip__text">
                  <b>{k.label}</b>
                  <small>{k.hint}</small>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="rq__set">
        <legend class="flabel">İlgili sistem</legend>
        <div class="rq__chips rq__chips--wrap">
          {
            systems.map((s) => (
              <label class="chip chip--small">
                <input type="checkbox" name="system" value={s} />
                <span class="chip__lamp" aria-hidden="true" />
                <span class="chip__text">
                  <b>{s}</b>
                </span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="rq__row">
        <div class="field">
          <label for="rq-vessel" class="flabel">Gemi adı</label>
          <input id="rq-vessel" name="vessel" type="text" autocomplete="off" placeholder="Örn. M/V …" />
        </div>
        <div class="field">
          <label for="rq-port" class="flabel">Liman / konum</label>
          <input id="rq-port" name="port" type="text" autocomplete="off" placeholder="Geminin bulunduğu yer" />
        </div>
      </div>

      <div class="field">
        <label for="rq-details" class="flabel">Kısa açıklama <span aria-hidden="true">*</span></label>
        <textarea id="rq-details" name="details" rows="4" required placeholder="Belirti, alarm kodu, etkilenen ekipman…" aria-describedby="rq-details-err"></textarea>
        <p class="field__err" id="rq-details-err" hidden>Lütfen arızayı ya da ihtiyacı kısaca yazın.</p>
      </div>

      <div class="rq__row">
        <div class="field">
          <label for="rq-name" class="flabel">Ad soyad <span aria-hidden="true">*</span></label>
          <input id="rq-name" name="name" type="text" autocomplete="name" required aria-describedby="rq-name-err" />
          <p class="field__err" id="rq-name-err" hidden>Size nasıl hitap edelim?</p>
        </div>
        <div class="field">
          <label for="rq-phone" class="flabel">Telefon</label>
          <input id="rq-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
      </div>

      <div class="rq__submit">
        <button class="btn btn--signal" type="submit">
          <Icon name="whatsapp" />
          <span>WhatsApp ile gönder</span>
        </button>
        <p class="rq__hint">Gönder’e bastığınızda WhatsApp, talebiniz yazılmış olarak açılır.</p>
      </div>
      <p class="rq__status" role="status" aria-live="polite" data-request-status></p>
    </form>
  </div>
</section>

<script>
  import { whatsappLink } from '../data/site';

  const form = document.querySelector<HTMLFormElement>('[data-request]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-request-status]')!;
    const required = ['details', 'name'] as const;

    const check = (name: string) => {
      const el = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
      const err = document.getElementById(`rq-${name}-err`);
      const ok = el.value.trim().length > 0;
      if (ok) el.removeAttribute('aria-invalid');
      else el.setAttribute('aria-invalid', 'true');
      if (err) err.hidden = ok;
      return ok;
    };
    required.forEach((n) => {
      const el = form.elements.namedItem(n) as HTMLInputElement;
      el.addEventListener('blur', () => el.hasAttribute('aria-invalid') && check(n));
      el.addEventListener('input', () => el.hasAttribute('aria-invalid') && check(n));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const results = required.map(check);
      if (results.includes(false)) {
        const first = required[results.indexOf(false)];
        (form.elements.namedItem(first) as HTMLElement).focus();
        return;
      }
      const d = new FormData(form);
      const val = (k: string) => String(d.get(k) ?? '').trim();
      const systems = d.getAll('system').map(String);
      const lines = [
        '*Servis talebi · erkonmarin*',
        `Talep türü: ${val('kind')}`,
        systems.length ? `Sistem: ${systems.join(', ')}` : null,
        val('vessel') ? `Gemi: ${val('vessel')}` : null,
        val('port') ? `Liman / konum: ${val('port')}` : null,
        '',
        val('details'),
        '',
        `${val('name')}${val('phone') ? ` · ${val('phone')}` : ''}`,
      ].filter((l): l is string => l !== null);

      window.open(whatsappLink(lines.join('\n')), '_blank', 'noopener');
      status.textContent = 'WhatsApp açıldı. Mesajı göndermeyi unutmayın; açılmadıysa bizi telefonla arayın.';
    });
  }
</script>

<style>
  .request {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    background:
      radial-gradient(60% 80% at 0% 100%, rgba(43, 187, 229, 0.18), transparent 70%),
      linear-gradient(160deg, #1d3388 0%, var(--c-navy-deep) 55%, #0f1f57 100%);
    overflow: hidden;
  }
  .request__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 110px);
    align-items: start;
  }
  .request__intro .h2 {
    font-size: clamp(40px, 4.8vw, 76px);
  }
  .request__intro .h2 em {
    color: var(--c-signal-hi);
  }
  .flabel {
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 600;
    color: #b9c6ea;
  }
  .request__intro .lead {
    margin-top: 28px;
    max-width: 460px;
    color: #d7e0f5;
  }

  .lines {
    margin: 48px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .lines__row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
  }
  .lines__row dt {
    padding-top: 6px;
  }
  .lines__row dd {
    margin: 0;
    display: grid;
    gap: 4px;
    font-size: 17px;
  }
  .lines__phone {
    font-family: var(--f-display);
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color 0.2s;
  }
  .lines__phone:hover {
    color: var(--c-signal-hi);
  }
  .lines__wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    width: fit-content;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .lines__wa :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.4s var(--ease-out);
  }
  .lines__wa:hover :global(svg) {
    transform: translateX(4px);
  }
  .lines__mail {
    width: fit-content;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    transition: color 0.2s;
  }
  .lines__mail:hover {
    color: var(--c-signal-hi);
  }

  .request__photo {
    margin: 48px 0 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    aspect-ratio: 3 / 2;
    background: var(--c-night);
  }
  .request__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Form */
  .rq {
    padding: clamp(24px, 3.6vw, 52px);
    background: rgba(5, 10, 25, 0.55);
    border: 1px solid rgba(143, 180, 255, 0.22);
    border-radius: var(--r-xl);
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6);
  }
  .rq__set {
    margin: 0 0 30px;
    padding: 0;
    border: 0;
  }
  .rq__set legend {
    padding: 0;
    margin-bottom: 14px;
  }
  .rq__chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .rq__chips--wrap {
    display: flex;
    flex-wrap: wrap;
  }

  .chip {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 15px 16px 16px;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-md);
    cursor: pointer;
    transition:
      border-color 0.25s,
      background-color 0.25s;
  }
  .chip:hover {
    border-color: rgba(143, 228, 251, 0.55);
  }
  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip__lamp {
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 5px;
    border-radius: 50%;
    background: #3b4766;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }
  .chip__text {
    display: grid;
    gap: 2px;
    line-height: 1.3;
  }
  .chip__text b {
    font-family: var(--f-display);
    font-weight: 650;
    font-size: 16px;
  }
  .chip__text small {
    color: var(--c-mist-2);
    font-size: 12.5px;
  }
  .chip:has(input:checked) {
    border-color: var(--c-signal);
    background: rgba(43, 187, 229, 0.1);
  }
  .chip:has(input:checked) .chip__lamp {
    background: var(--c-lamp-green);
    box-shadow: 0 0 12px var(--c-lamp-green);
  }
  .chip--urgent:has(input:checked) {
    border-color: var(--c-amber);
    background: rgba(255, 176, 32, 0.1);
  }
  .chip--urgent:has(input:checked) .chip__lamp {
    background: var(--c-amber);
    box-shadow: 0 0 12px var(--c-amber);
  }
  .chip:has(input:focus-visible) {
    outline: 2px solid var(--c-signal);
    outline-offset: 3px;
  }
  .chip--small {
    padding: 11px 18px 11px 14px;
    border-radius: var(--r-pill);
  }
  .chip--small .chip__lamp {
    margin-top: 4px;
  }
  .chip--small .chip__text b {
    font-size: 14px;
  }

  .rq__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .field {
    display: grid;
    gap: 8px;
    margin-bottom: 24px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(143, 180, 255, 0.22);
    border-radius: var(--r-md);
    color: #fff;
    font-size: 17px;
    transition:
      border-color 0.25s,
      background-color 0.25s,
      box-shadow 0.25s;
  }
  .field textarea {
    resize: vertical;
    min-height: 110px;
    line-height: 1.5;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #5d6b90;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-signal);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 4px rgba(43, 187, 229, 0.18);
  }
  .field [aria-invalid] {
    border-color: var(--c-lamp-red);
  }
  .field__err {
    color: #ff9a92;
    font-size: 14px;
  }

  .rq__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 8px;
  }
  .rq__submit .btn :global(svg) {
    width: 20px;
    height: 20px;
  }
  .rq__hint {
    flex: 1 1 220px;
    color: var(--c-mist);
    font-size: 14px;
  }
  .rq__status {
    margin-top: 18px;
    color: var(--c-signal-hi);
    font-size: 15px;
  }
  .rq__status:empty {
    display: none;
  }

  @media (max-width: 1080px) {
    /* one column: heading and lead, then the form, then the contact list */
    .request__grid {
      grid-template-columns: 1fr;
      row-gap: 0;
    }
    .request__intro {
      display: contents;
    }
    .rq {
      order: 1;
      margin-top: 40px;
    }
    .lines {
      order: 2;
    }
    .request__photo {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .rq__chips {
      grid-template-columns: 1fr;
    }
    .rq__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .lines__row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .rq__submit .btn {
      width: 100%;
    }
  }
</style>
