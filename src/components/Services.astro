---
// Each service is drawn as a feeder on a single-line diagram: an IEC breaker
// symbol hanging off the main bus. Breakers close (energise) as the section
// scrolls in, and on hover.
import { anchors, langOf } from '../i18n';
const lang = langOf(Astro.currentLocale);

const copy = {
  tr: {
    title: ['Dört iş.', 'Tek muhatap.'],
    lead: 'Arızayı bulan, bakımı yapan, panoyu kuran ve gerektiğinde söken aynı ekip. Sistemi baştan sona bilen tek bir muhatabınız olur; bilgi el değiştirirken kaybolmaz.',
    out: 'Teslim:',
    items: [
      {
        title: 'Arıza tespiti',
        text: 'Ölçüm, şema takibi ve sistematik eleme ile arızanın kök nedenine ineriz. Parçayı değiştirip şansımızı denemeyiz.',
        out: 'Teşhis ve onarım raporu',
      },
      {
        title: 'Bakım',
        text: 'Periyodik ve önleyici bakımla arızayı seferin ortasında değil, sizin planladığınız günde karşılarsınız.',
        out: 'Bakım kaydı ve öneri listesi',
      },
      {
        title: 'Montaj',
        text: 'Pano ve otomasyon ekipmanlarının montajı, kablajı, testi ve devreye alınması.',
        out: 'Devreye alma test sonuçları',
      },
      {
        title: 'Demontaj',
        text: 'Değişecek ya da sökülecek sistemlerin etiketlenerek, belgelenerek ve güvenle sökülmesi.',
        out: 'Söküm ve etiket dokümanı',
      },
    ],
  },
  en: {
    title: ['Four jobs.', 'One contact.'],
    lead: 'The same team finds the fault, carries out the maintenance, installs the panel and removes it when the time comes. You deal with one contact who knows the system end to end, so nothing gets lost in handovers.',
    out: 'Delivered:',
    items: [
      {
        title: 'Fault diagnosis',
        text: 'We get to the root cause through measurement, tracing the drawings and systematic elimination. We don’t swap parts and hope for the best.',
        out: 'Diagnosis and repair report',
      },
      {
        title: 'Maintenance',
        text: 'With periodic and preventive maintenance, you deal with faults on a day you planned, not in the middle of a voyage.',
        out: 'Maintenance record and recommendations',
      },
      {
        title: 'Installation',
        text: 'Installation, wiring, testing and commissioning of switchboard and automation equipment.',
        out: 'Commissioning test results',
      },
      {
        title: 'Removal',
        text: 'Systems due for replacement or removal are labelled, documented and taken out safely.',
        out: 'Removal and labelling documentation',
      },
    ],
  },
}[lang];
const services = copy.items;
---

<section class="services" data-nav-tone="light" id={anchors.scope[lang]} aria-labelledby="scope-title">
  <div class="container">
    <header class="services__head">
      <h2 class="h2" id="scope-title" data-reveal>{copy.title[0]}<br /><em>{copy.title[1]}</em></h2>
      <p class="lead services__lead" data-reveal style="--d:160">{copy.lead}</p>
    </header>

    <div class="sld" data-sld>
      <div class="sld__bus" aria-hidden="true">
        <span class="sld__bus-line"><span></span></span>
      </div>
      <ol class="sld__feeders" role="list">
        {
          services.map((s, i) => (
            <li class="feeder" style={`--i:${i}`}>
              <svg class="feeder__sym feeder__sym--v" viewBox="0 0 48 120" aria-hidden="true">
                <line x1="24" y1="0" x2="24" y2="40" />
                <path class="feeder__x" d="M18.5 34.5l11 11M29.5 34.5l-11 11" />
                <g class="feeder__blade">
                  <line x1="24" y1="86" x2="24" y2="40" />
                </g>
                <circle class="feeder__pivot" cx="24" cy="86" r="3.2" />
                <line x1="24" y1="86" x2="24" y2="120" />
              </svg>
              <svg class="feeder__sym feeder__sym--h" viewBox="0 0 96 48" aria-hidden="true">
                <line x1="0" y1="24" x2="26" y2="24" />
                <path class="feeder__x" d="M20.5 18.5l11 11M31.5 18.5l-11 11" />
                <g class="feeder__blade">
                  <line x1="70" y1="24" x2="26" y2="24" />
                </g>
                <circle class="feeder__pivot" cx="70" cy="24" r="3.2" />
                <line x1="70" y1="24" x2="96" y2="24" />
              </svg>
              <div class="feeder__body">
                <span class="feeder__n numeral" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="feeder__title h3">{s.title}</h3>
                <p class="feeder__text">{s.text}</p>
                <p class="feeder__out">
                  {copy.out} <em class="serif">{s.out}</em>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  const sld = document.querySelector<HTMLElement>('[data-sld]');
  if (sld) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          sld.classList.add('is-live');
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(sld);
  }
</script>

<style>
  .services {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px) clamp(64px, 7vw, 110px);
    background-color: var(--c-paper);
    background-image:
      linear-gradient(rgba(10, 17, 40, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 17, 40, 0.035) 1px, transparent 1px);
    background-size: 40px 40px;
    color: var(--c-ink);
  }

  .services__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 48px;
    align-items: end;
  }
  .services__head .h2 em {
    color: var(--c-navy);
  }
  .services__lead {
    color: var(--c-ink-2);
    max-width: 520px;
  }

  /* Single-line diagram */
  .sld {
    --wire-off: rgba(10, 17, 40, 0.3);
    --wire-on: var(--c-navy);
    margin-top: clamp(64px, 8vw, 120px);
  }
  .sld__bus {
    position: relative;
    display: block;
  }
  .sld__bus-line {
    position: relative;
    display: block;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--wire-off);
    overflow: hidden;
  }
  .sld__bus-line span {
    position: absolute;
    inset: 0;
    background: var(--wire-on);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s var(--ease-in-out);
  }
  .sld__bus-line::after {
    /* current running along the bus */
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    background: linear-gradient(90deg, transparent, var(--c-signal), transparent);
    opacity: 0;
    transform: translateX(-140px);
  }
  .sld.is-live .sld__bus-line span {
    transform: scaleX(1);
  }

  .sld__feeders {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin: 0;
  }

  .feeder {
    --delay: calc(900ms + var(--i) * 260ms);
    display: flex;
    flex-direction: column;
  }
  .feeder__sym {
    width: 48px;
    height: 120px;
    overflow: visible;
  }
  .feeder__sym--h {
    display: none;
  }
  .feeder__sym--h .feeder__blade {
    transform-origin: 70px 24px;
    transform: rotate(30deg);
  }
  .feeder__sym line,
  .feeder__x {
    stroke: var(--wire-off);
    stroke-width: 2.2;
    stroke-linecap: round;
    fill: none;
    transition: stroke 0.5s var(--ease-out) var(--delay);
  }
  .feeder__pivot {
    fill: var(--c-paper);
    stroke: var(--wire-off);
    stroke-width: 2;
    transition: stroke 0.5s var(--ease-out) var(--delay);
  }
  .feeder__blade {
    transform-box: view-box;
    transform-origin: 24px 86px;
    transform: rotate(-30deg);
    transition: transform 0.7s cubic-bezier(0.5, 0, 0.2, 1.4) var(--delay);
  }

  .feeder__body {
    flex: 1;
    margin-left: 23px;
    padding: 4px 0 8px 30px;
    border-left: 2px solid var(--wire-off);
    transition: border-color 0.5s var(--ease-out) calc(var(--delay) + 250ms);
  }
  .feeder__n {
    display: block;
    font-size: 40px;
    font-style: italic;
    color: var(--c-ink-3);
    transition: color 0.4s var(--ease-out) var(--delay);
  }
  .feeder__title {
    margin-top: 10px;
    font-size: clamp(28px, 2.6vw, 38px);
  }
  .feeder__text {
    margin-top: 16px;
    color: var(--c-ink-2);
    font-size: 16px;
    text-wrap: pretty;
  }
  .feeder__out {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--c-line-light-2);
    color: var(--c-ink-3);
    font-size: 14px;
  }
  .feeder__out em {
    display: block;
    margin-top: 2px;
    color: var(--c-ink);
    font-size: 19px;
    line-height: 1.3;
  }

  /* energised */
  .sld.is-live .feeder__sym line,
  .sld.is-live .feeder__x,
  .sld.is-live .feeder__pivot {
    stroke: var(--wire-on);
  }
  .sld.is-live .feeder__blade {
    transform: rotate(0deg);
  }
  .sld.is-live .feeder__body {
    border-color: var(--wire-on);
  }
  .sld.is-live .feeder__n {
    color: var(--c-navy);
  }

  /* hover: a quick current pulse down the feeder */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .feeder__body {
      position: relative;
    }
    .feeder__body::before {
      content: '';
      position: absolute;
      left: -2px;
      top: 0;
      width: 2px;
      height: 80px;
      background: linear-gradient(180deg, transparent, var(--c-signal), transparent);
      opacity: 0;
    }
    .sld.is-live .feeder:hover .feeder__body::before {
      animation: pulse-down 1.1s var(--ease-in-out);
    }
    .sld.is-live .sld__bus-line::after {
      animation: bus-run 3.6s var(--ease-in-out) 2.4s infinite;
    }
  }

  @keyframes pulse-down {
    0% {
      opacity: 1;
      transform: translateY(-40px);
    }
    100% {
      opacity: 0;
      transform: translateY(260px);
    }
  }
  @keyframes bus-run {
    0% {
      opacity: 1;
      transform: translateX(-140px);
    }
    70%,
    100% {
      opacity: 0.9;
      transform: translateX(110vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sld * {
      transition: none !important;
    }
  }

  @media (max-width: 760px) {
    .services__head {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 1080px) {
    /* vertical bus, feeders branch to the right */
    .sld {
      position: relative;
      margin-top: 56px;
    }
    .sld__bus {
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 5px;
    }
      .sld__bus-line {
      width: 5px;
      height: 100%;
    }
    .sld__bus-line span {
      transform: scaleY(0);
      transform-origin: top;
    }
    .sld.is-live .sld__bus-line span {
      transform: scaleY(1);
    }
    .sld__bus-line::after {
      display: none;
    }
    .sld__feeders {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .feeder {
      flex-direction: row;
      align-items: flex-start;
    }
    .feeder__sym--v {
      display: none;
    }
    .feeder__sym--h {
      display: block;
      flex: none;
      width: 72px;
      height: 36px;
      margin-left: 4px;
    }
    .feeder__body {
      margin-left: 10px;
      border-left: 0;
      padding: 4px 0 44px;
    }
    .feeder__title {
    margin-top: 10px;
    font-size: clamp(28px, 2.6vw, 38px);
  }
    .feeder__body::before {
      display: none;
    }
  }
</style>
