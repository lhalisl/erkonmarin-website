---
const steps = [
  {
    step: 'Bildirim',
    what: 'Gemi adı, liman ve belirtiyi telefon, WhatsApp ya da form ile iletirsiniz.',
    out: 'İş kaydı açılır',
  },
  {
    step: 'Ön değerlendirme',
    what: 'Belirtileri ve mevcut şemaları inceler, ekipman ve olası yedek parça ihtiyacını önceden planlarız.',
    out: 'Müdahale planı',
  },
  {
    step: 'Sahada müdahale',
    what: 'Gemide ölçüm ve teşhis yapar; onarım, bakım, montaj ya da demontaj işini tamamlarız.',
    out: 'Çalışır durumda sistem',
  },
  {
    step: 'Test ve teslim',
    what: 'Sistemi test eder, yapılan işi ve değişen parçaları raporlayarak teslim ederiz.',
    out: 'Servis raporu',
  },
];
---

<section class="process" data-nav-tone="light" id="surec" aria-labelledby="process-title">
  <div class="container process__grid">
    <header class="process__head">
      <h2 class="h2" id="process-title" data-reveal>Her iş, <em>seyir defteri</em> gibi kayıtlı.</h2>
      <p class="process__lead" data-reveal style="--d:120">
        Ne zaman aradığınızı, ne bulduğumuzu, neyi değiştirdiğimizi bilirsiniz. Gemiden ayrıldığımızda elinizde sürpriz değil,
        rapor olur.
      </p>
    </header>

    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 80}`}>
            <span class="step__n numeral" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="step__body">
              <h3 class="step__title h3">{s.step}</h3>
              <p class="step__what">{s.what}</p>
              <p class="step__out">
                <span class="lamp" aria-hidden="true" />
                {s.out}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(96px, 12vw, 180px);
    background: var(--c-paper-hi);
    color: var(--c-ink);
  }
  .process__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .process__head {
    position: sticky;
    top: calc(var(--header-h) + 48px);
  }
  .process__head .h2 {
    font-size: clamp(40px, 4.8vw, 76px);
  }
  .process__head .h2 em {
    color: var(--c-navy);
  }
  .process__lead {
    margin-top: 28px;
    max-width: 440px;
    color: var(--c-ink-2);
    font-size: clamp(17px, 1.35vw, 20px);
    text-wrap: pretty;
  }

  .steps {
    margin: 0;
    border-top: 1px solid var(--c-line-light-2);
  }
  .step {
    display: grid;
    grid-template-columns: clamp(72px, 8vw, 120px) minmax(0, 1fr);
    gap: 8px;
    padding: 36px 0 40px;
    border-bottom: 1px solid var(--c-line-light-2);
  }
  .step__n {
    font-size: clamp(48px, 5vw, 76px);
    font-style: italic;
    color: var(--c-navy);
  }
  .step__title {
    padding-top: 8px;
    font-size: clamp(26px, 2.4vw, 36px);
  }
  .step__what {
    margin-top: 12px;
    max-width: 520px;
    color: var(--c-ink-2);
    font-size: 17px;
    text-wrap: pretty;
  }
  .step__out {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 9px 18px 9px 14px;
    border: 1px solid var(--c-line-light-2);
    border-radius: var(--r-pill);
    background: #fff;
    font-family: var(--f-display);
    font-size: 14.5px;
    font-weight: 650;
  }
  .step__out .lamp {
    width: 7px;
    height: 7px;
  }

  @media (max-width: 1080px) {
    .process__grid {
      grid-template-columns: 1fr;
    }
    .process__head {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .step {
      grid-template-columns: 56px minmax(0, 1fr);
      padding: 28px 0 32px;
    }
    .step__n {
      font-size: 40px;
    }
    .step__title {
      padding-top: 4px;
    }
    .step__what {
      font-size: 16px;
    }
  }
</style>
