---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
// Stand-ins for Grift (display) and Commune (serif) until the licensed files are in public/fonts
import '@fontsource-variable/urbanist/wght.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '../styles/fonts.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import displayLatin from '@fontsource-variable/urbanist/files/urbanist-latin-wght-normal.woff2?url';
import LogoSprite from '../components/LogoSprite.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/media/og.jpg' } = Astro.props;

// Link previews (WhatsApp, Facebook, LinkedIn) need absolute URLs
const isErrorPage = /\/404/.test(Astro.url.pathname);
const canonical = Astro.site && !isErrorPage ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  telephone: site.phones.map((p) => p.e164),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  knowsAbout: [
    'Gemi elektrik sistemleri',
    'Ana dağıtım panosu (MSB)',
    'Makine kontrol odası',
    'Gemi otomasyon panoları',
  ],
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050a19" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />

    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <LogoSprite />
    <slot />
    <script>
      // Reveal-on-scroll for [data-reveal]
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
