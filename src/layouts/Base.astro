---
// Plex Mono only draws the equipment screens inside the 3D scene; page text is Franie
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/fonts.css';
import '../styles/global.css';
import LogoSprite from '../components/LogoSprite.astro';
import SocialRail from '../components/SocialRail.astro';
import { site } from '../data/site';
import { langOf, ui, type Alternates } from '../i18n';
import { JS_CLASS } from '../scripts/inline.mjs';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** The same page in each language (hreflang, and the header's language switch). */
  alternates?: Alternates;
}

const lang = langOf(Astro.currentLocale);
const { title, description = site.description[lang], image = lang === 'en' ? '/media/og-en.jpg' : '/media/og.jpg', alternates } =
  Astro.props;

// Link previews (WhatsApp, Facebook, LinkedIn) need absolute URLs
const isErrorPage = /\/404/.test(Astro.url.pathname);
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = !isErrorPage ? abs(Astro.url.pathname) : undefined;
const ogImage = abs(image) ?? image;
const hreflang = Astro.site && alternates && !isErrorPage ? alternates : undefined;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description[lang],
  telephone: site.phones.map((p) => p.e164),
  email: site.email,
  sameAs: Object.values(site.social).filter(Boolean),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.district,
    addressRegion: site.address.city,
    addressCountry: site.address.country,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '18:00',
    },
  ],
  knowsAbout:
    lang === 'tr'
      ? [
          'Gemi elektrik sistemleri',
          'Ana dağıtım panosu (MSB)',
          'Makine kontrol odası',
          'Gemi otomasyon panoları',
          'Ana makine sistemleri',
          'Jeneratör (D/G) otomasyonu',
          'Köprüüstü seyir sistemleri',
          'Romorkör ve SAR botlar',
        ]
      : [
          'Marine electrical systems',
          'Main switchboards (MSB)',
          'Engine control rooms',
          'Ship automation panels',
          'Main engine systems',
          'Generator (D/G) automation',
          'Bridge navigation systems',
          'Tugs and SAR boats',
        ],
  knowsLanguage: ['tr', 'en'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08112a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/franie-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/franie-900.woff2" as="font" type="font/woff2" crossorigin />

    {canonical && <link rel="canonical" href={canonical} />}
    {
      hreflang && (
        <>
          <link rel="alternate" hreflang="tr" href={abs(hreflang.tr)} />
          <link rel="alternate" hreflang="en" href={abs(hreflang.en)} />
          <link rel="alternate" hreflang="x-default" href={abs(hreflang.tr)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_GB' : 'tr_TR'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline set:html={JS_CLASS} />
    <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <LogoSprite />
    <slot />
    <SocialRail />
    <script>
      // Keyboard focus that lands partly under the fixed header (the browser leaves
      // partly visible elements where they are) is nudged just below it. The
      // timeline island places its own focus.
      document.addEventListener('focusin', (e) => {
        const el = e.target;
        if (!(el instanceof HTMLElement) || !el.matches(':focus-visible')) return;
        if (el.closest('[data-header], [data-tl-item], [data-tl-outro]')) return;
        const bar = document.querySelector('[data-header] .bar');
        if (!bar) return;
        const limit = bar.getBoundingClientRect().bottom + 12;
        const r = el.getBoundingClientRect();
        if (r.top < limit && r.bottom > 0) window.scrollBy({ top: r.top - limit, behavior: 'instant' });
      });
    </script>
    <script>
      // Reveal-on-scroll for [data-reveal]
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
