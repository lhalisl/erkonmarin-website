---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Sayfa bulunamadı · Erkon Marin">
  <Header />
  <main id="main" class="nf">
    <div class="container nf__inner">
      <p class="label nf__code"><span class="lamp lamp--off"></span>404 · Hat enerjisiz</p>
      <h1 class="display nf__title">Bu hatta akım yok.</h1>
      <p class="lead nf__lead">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Ana sayfadan devam edebilirsiniz.</p>
      <a class="btn btn--signal" href="/">
        <span>Ana sayfaya dön</span>
        <Icon name="arrow" />
      </a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .nf {
    min-height: 88vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(60% 60% at 80% 40%, rgba(34, 57, 143, 0.35), transparent 70%),
      var(--c-deep);
  }
  .nf__inner {
    padding-block: 180px 120px;
  }
  .nf__code {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--c-mist);
  }
  .nf__title {
    margin-top: 28px;
    font-size: clamp(48px, 8vw, 128px);
    max-width: 12ch;
  }
  .nf__lead {
    margin: 28px 0 40px;
    max-width: 520px;
    color: #c9d3ea;
  }
</style>
