---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import Icon from '../components/Icon.astro';
import team from '../assets/hakkimizda/erkon-marin-ekip.jpg';
import { services, serviceHref } from '../data/services';

// Copy supplied by Erkon Marin, used verbatim. Headings and the decorative
// strips (brand names, system lamps) only restate what the paragraphs say.

const link = (slug: string) => serviceHref(services.find((s) => s.slug === slug)!);

const lead =
  'Erkon Marin olarak, 35 yılı aşkın denizcilik elektroniği, seyir cihazları ve gemi otomasyon sistemleri deneyimimizi ticari gemilere ve romorkörlere profesyonel çözümler sunmak için kullanıyoruz.';
const brands = ['Raytheon', 'Kelvin Hughes', 'Sperry', 'Decca', 'Furuno', 'Sailor', 'JRC', 'Gylot'];
const systems = ['Elektrik', 'Elektronik', 'Hidrolik', 'Pnömatik', 'Otomasyon'];
const today = [
  'Denizcilik elektrik & elektronik sistemleri tamiri',
  'Radar, gyro, autopilot, VHF ve diğer seyir cihazlarının bakımı',
  'Gemi elektrik arızaları ve otomasyon sistemleri çözümü',
  'Romorkör ve ticari gemilere teknik destek',
  'Klima (HVAC), yazılım ve diğer gemi sistemlerinde uzman müdahale',
  'Gemide mevcut elektrik-elektronik şemalar ve yedek parçalar doğrultusunda hızlı servis',
];

const description = `${lead.slice(0, lead.lastIndexOf(' ', 155))}…`;
---

<Base title="Hakkımızda | Erkon Marin" description={description}>
  <Header />
  <main id="main">
    <header class="hero">
      <div class="container hero__grid">
        <div class="hero__text">
          <h1 class="display hero__title">Hakkımızda</h1>
          <p class="hero__lead">
            Erkon Marin olarak, <span class="hl">35 yılı aşkın</span> denizcilik elektroniği, seyir cihazları ve gemi otomasyon sistemleri
            deneyimimizi ticari gemilere ve romorkörlere profesyonel çözümler sunmak için kullanıyoruz.
          </p>
        </div>
        <figure class="hero__photo">
          <Image
            src={team}
            alt="Erkon Marin ekibinden iki kişi; arkalarında İstanbul Boğazı"
            widths={[420, 640, 900, 1070]}
            sizes="(max-width: 900px) calc(100vw - 40px), 36vw"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="stat">
            <span class="stat__n numeral">35<span class="stat__plus">+</span></span>
            <span class="stat__l">yıl denizcilik elektroniği deneyimi</span>
          </figcaption>
        </figure>
      </div>
    </header>

    <section class="story" data-nav-tone="light" aria-labelledby="story-title">
      <div class="container">
        <h2 class="h2 story__title" id="story-title" data-reveal>Mesleki <em>yolculuğumuz</em></h2>

        <div class="journey" data-journey>
          <div class="journey__rail" aria-hidden="true"><span data-journey-fill></span></div>
          <ol role="list" class="journey__list">
            <li class="stop" data-stop>
              <span class="stop__dot" aria-hidden="true"></span>
              <p class="stop__mark numeral">1988</p>
              <div class="stop__body">
                <h3 class="h3 stop__title">D.B. Deniz Nakliyat T.A.Ş.</h3>
                <p>
                  Mesleki yolculuğumuz 1988 yılında, Türkiye’nin en köklü denizcilik kurumlarından biri olan D.B. Deniz Nakliyat T.A.Ş.’nin
                  elektronik tamir ekibinde başladı.
                </p>
                <p>
                  Bu dönemde birçok seyir ve haberleşme sisteminin tamir, bakım ve montaj/demontaj işlemlerini gerçekleştirdik. Bunlar arasında:
                </p>
                <p class="stop__key">
                  <strong>Raytheon, Kelvin Hughes, Sperry, Decca, Furuno, Sailor, JRC, Gylot</strong> gibi markaların{' '}
                  <a href={link('seyir-sistemleri')}>radar, gyro, autopilot, VHF telsiz ve çeşitli köprüüstü (bridge) cihazları</a> yer alıyordu.
                </p>
                <ul class="brands" aria-hidden="true">
                  {brands.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            </li>

            <li class="stop" data-stop>
              <span class="stop__dot" aria-hidden="true"></span>
              <p class="stop__mark numeral">Ardından</p>
              <div class="stop__body">
                <h3 class="h3 stop__title">Kıyı Emniyeti Genel Müdürlüğü</h3>
                <p>
                  Edindiğimiz bu geniş tecrübeyle, daha sonra Kıyı Emniyet Genel Müdürlüğü bünyesinde ilk Elektrik-Elektronik Tamir Ekibini kurduk.
                </p>
                <p>
                  Bu ekip ile <a href={link('romorkor-ve-sar-botlar')}>romorkör, SAR Boat</a> ve kurum bünyesindeki tüm yüzer araçların elektrik,
                  elektronik, hidrolik, pnömatik ve otomasyon sistemlerinin arıza tespiti ve bakım çalışmalarını yürüttük.
                </p>
                <p>
                  Ayrıca <a href={link('ana-makine')}>Ana Makine</a> ve <a href={link('yardimci-makine')}>Yardımcı Makinelerin (Jeneratör/DG)</a> arıza
                  tespitlerini ve bakımlarını da gerçekleştirdik.
                </p>
                <ul class="annunciator" aria-hidden="true">
                  {
                    systems.map((s, i) => (
                      <li style={`--i:${i}`}>
                        <span class="lamp" />
                        {s}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </li>

            <li class="stop" data-stop>
              <span class="stop__dot" aria-hidden="true"></span>
              <p class="stop__mark numeral">Bugün</p>
              <div class="stop__body">
                <h3 class="h3 stop__title">Erkon Marin</h3>
                <p>Günümüzde Erkon Marin olarak sunduğumuz hizmetler:</p>
                <ul role="list" class="offer">
                  {
                    today.map((t, i) => (
                      <li>
                        <span class="offer__n numeral" aria-hidden="true">
                          {String(i + 1).padStart(2, '0')}
                        </span>
                        <span>{t}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="mission" aria-labelledby="mission-title">
      <div class="mission__axis" aria-hidden="true"><span></span></div>
      <div class="container mission__inner">
        <h2 class="display mission__big" id="mission-title" data-reveal>
          Erkon Marin’in misyonu, 35 yıllık saha deneyimiyle <em>hızlı, doğru ve kaliteli</em> denizcilik teknik hizmeti sunmaktır.
        </h2>
        <p class="lead mission__lead" data-reveal style="--d:120">
          İster ticari gemi, ister romorkör, ister kıyı operasyon araçları olsun; her bir gemi için güvenilir, profesyonel ve uzun ömürlü
          çözümler üretiyoruz.
        </p>
        <div class="mission__actions" data-reveal style="--d:200">
          <a class="btn btn--signal" href="/iletisim/#talep">
            <span>Servis talebi</span>
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href="/hizmetler/">
            <span>Hizmetlerimiz</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileDock />
</Base>

<script>
  // The rail fills as the story scrolls past the reading line; each stop's dot
  // lights once the fill reaches it.
  const journey = document.querySelector<HTMLElement>('[data-journey]');
  const fill = journey?.querySelector<HTMLElement>('[data-journey-fill]');
  if (journey && fill) {
    const stops = Array.from(journey.querySelectorAll<HTMLElement>('[data-stop]'));
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.62;
      const r = journey.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
      fill.style.transform = `scaleY(${p.toFixed(4)})`;
      for (const s of stops) {
        const dot = s.querySelector<HTMLElement>('.stop__dot')!;
        s.toggleAttribute('data-lit', dot.getBoundingClientRect().top < line);
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>

<style>
  /* ---- Hero ---------------------------------------------------- */
  .hero {
    padding: calc(var(--header-h) + clamp(48px, 7vw, 112px)) 0 clamp(72px, 9vw, 140px);
    background:
      radial-gradient(60% 80% at 88% 0%, rgba(43, 187, 229, 0.12), transparent 62%),
      var(--c-abyss);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: end;
  }
  .hero__title {
    font-size: clamp(56px, 8.4vw, 144px);
  }
  .hero__lead {
    max-width: 30ch;
    margin-top: clamp(28px, 3vw, 48px);
    font-family: var(--f-display);
    font-size: clamp(22px, 2.15vw, 34px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: #dfe6f6;
    text-wrap: pretty;
  }
  .hl {
    color: var(--c-signal);
  }
  .hero__photo {
    position: relative;
    justify-self: end;
    width: min(100%, 520px);
  }
  .hero__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-xl);
    /* the source is a small, upscaled snapshot; a gentle grade keeps it in the site's palette */
    filter: saturate(0.9) contrast(1.04);
  }
  .stat {
    position: absolute;
    left: clamp(-56px, -3.2vw, -20px);
    bottom: clamp(28px, 3vw, 44px);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 22px 14px 18px;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-lg);
    background: rgba(8, 17, 42, 0.78);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 24px 50px -28px rgba(0, 0, 0, 0.8);
  }
  .stat__n {
    font-size: clamp(44px, 4vw, 60px);
    font-style: italic;
    color: var(--c-signal);
  }
  /* the serif italic plus is a hairline; set it in the display face */
  .stat__plus {
    margin-left: 0.04em;
    font-family: var(--f-display);
    font-size: 0.56em;
    font-style: normal;
    font-weight: 700;
    vertical-align: 0.62em;
  }
  .stat__l {
    max-width: 13ch;
    font-family: var(--f-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    color: #eef2fb;
  }

  /* ---- Story --------------------------------------------------- */
  .story {
    padding-block: clamp(88px, 11vw, 168px);
    background: var(--c-paper-hi);
    color: var(--c-ink);
  }
  .story__title {
    font-size: clamp(42px, 5.2vw, 88px);
  }
  .story__title em {
    color: var(--c-navy);
  }
  .journey {
    --jp: clamp(36px, 4vw, 64px);
    --dot: 14px;
    position: relative;
    margin-top: clamp(48px, 6vw, 96px);
    padding-left: var(--jp);
  }
  .journey__rail {
    position: absolute;
    top: 0.9em;
    bottom: 0;
    left: calc(var(--dot) / 2);
    width: 1px;
    background: var(--c-line-light-2);
  }
  .journey__rail span {
    position: absolute;
    inset: 0;
    background: var(--c-signal-dim);
    transform-origin: top;
  }
  :global(.js) .journey__rail span {
    transform: scaleY(0);
  }
  .journey__list {
    display: grid;
    gap: clamp(64px, 8vw, 128px);
    margin: 0;
  }
  .stop {
    position: relative;
    display: grid;
    grid-template-columns: clamp(200px, 21vw, 340px) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 56px);
  }
  .stop__dot {
    position: absolute;
    top: 0.9em;
    left: calc(-1 * var(--jp));
    width: var(--dot);
    height: var(--dot);
    margin-top: calc(var(--dot) / -2);
    border-radius: 50%;
    border: 1px solid var(--c-line-light-2);
    background: var(--c-paper-hi);
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }
  .stop[data-lit] .stop__dot,
  :global(html:not(.js)) .stop__dot {
    border-color: var(--c-signal-dim);
    background: var(--c-signal);
    box-shadow: 0 0 0 5px rgba(43, 187, 229, 0.18);
  }
  .stop__mark {
    font-size: clamp(44px, 4.4vw, 76px);
    font-style: italic;
    line-height: 0.9;
    color: var(--c-navy);
  }
  .stop__body {
    display: grid;
    gap: 1.1em;
    max-width: 64ch;
    color: var(--c-ink-2);
    font-size: clamp(17px, 1.25vw, 19.5px);
    line-height: 1.7;
    text-wrap: pretty;
  }
  .stop__title {
    margin-bottom: 0.1em;
    font-size: clamp(26px, 2.4vw, 38px);
    color: var(--c-ink);
  }
  .stop__body strong {
    color: var(--c-ink);
    font-weight: 650;
  }
  .stop__body a {
    color: var(--c-navy);
    text-decoration-color: color-mix(in srgb, var(--c-navy) 35%, transparent);
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.25s var(--ease-out);
  }
  .stop__body a:hover {
    text-decoration-color: currentColor;
  }
  .story :global(:focus-visible) {
    outline-color: var(--c-navy);
  }

  /* brand names as a grid of nameplates */
  .brands {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0.4em 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line-light-2);
  }
  .brands li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 12px 16px 0;
    border-bottom: 1px solid var(--c-line-light-2);
    font-family: var(--f-serif);
    font-style: italic;
    font-size: clamp(21px, 1.9vw, 30px);
    font-variation-settings: 'opsz' 72;
    line-height: 1.1;
    color: var(--c-ink);
  }
  .brands li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-signal);
  }

  /* systems as a lit alarm panel */
  .annunciator {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    margin: 0.4em 0 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border: 1px solid var(--c-ink);
    border-radius: var(--r-md);
    background: rgba(143, 180, 255, 0.16);
  }
  .annunciator li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 14px 14px;
    background: var(--c-ink);
    color: #dfe6f6;
    font-family: var(--f-display);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .annunciator .lamp {
    --lamp: #6b7488;
    box-shadow: 0 0 0 2px rgba(107, 116, 136, 0.25);
    transition:
      background-color 0.3s linear,
      box-shadow 0.3s linear;
    transition-delay: calc(var(--i) * 140ms + 300ms);
  }
  .stop[data-lit] .annunciator .lamp,
  :global(html:not(.js)) .annunciator .lamp {
    --lamp: var(--c-lamp-green);
    box-shadow:
      0 0 0 2px color-mix(in srgb, var(--lamp) 22%, transparent),
      0 0 12px var(--lamp);
  }

  .offer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0.2em 0 0;
  }
  .offer li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding: 20px 22px;
    border: 1px solid var(--c-line-light);
    border-radius: var(--r-md);
    background: #fff;
    color: var(--c-ink);
    font-size: 16.5px;
    line-height: 1.45;
  }
  .offer__n {
    font-size: 22px;
    font-style: italic;
    color: var(--c-navy);
  }

  /* ---- Mission ------------------------------------------------- */
  .mission {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    overflow: hidden;
  }
  .mission__axis {
    position: absolute;
    top: clamp(48px, 6vw, 88px);
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--c-signal) 0%, rgba(43, 187, 229, 0.25) 55%, transparent 100%);
  }
  .mission__axis span {
    position: absolute;
    top: -5px;
    /* the container's content edge, so the dot continues the story rail above */
    left: calc(max(0px, (100% - var(--maxw)) / 2) + var(--gutter));
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 0 6px rgba(43, 187, 229, 0.16);
  }
  .mission__big {
    max-width: 20ch;
    font-size: clamp(38px, 5vw, 84px);
    line-height: 1;
  }
  .mission__big em {
    color: var(--c-signal);
  }
  .mission__lead {
    max-width: 52ch;
    margin-top: clamp(28px, 3vw, 44px);
    color: var(--c-mist);
  }
  .mission__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(32px, 4vw, 56px);
  }

  @media (max-width: 1080px) {
    .stop {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .offer {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__photo {
      justify-self: start;
      width: min(100%, 480px);
      margin-left: 0;
    }
    .stat {
      left: 16px;
      bottom: 16px;
    }
  }
  @media (max-width: 640px) {
    .brands {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .annunciator {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .annunciator li:last-child {
      grid-column: 1 / -1;
    }
    .offer li {
      padding: 18px;
    }
  }
</style>
