---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDock from '../components/MobileDock.astro';
import Icon from '../components/Icon.astro';
import TeamPhoto from '../components/TeamPhoto.astro';
import Journey from '../components/Journey.astro';
import { about } from '../data/about';

// Copy supplied by Erkon Marin, used verbatim (src/data/about.ts, Journey.astro).
const lead = about.lead;
const description = `${lead.slice(0, lead.lastIndexOf(' ', 155))}…`;
---

<Base title="Hakkımızda | Erkon Marin" description={description}>
  <Header />
  <main id="main">
    <header class="hero">
      <div class="container hero__grid">
        <div class="hero__text">
          <h1 class="display hero__title">Hakkımızda</h1>
          <p class="hero__lead">
            Erkon Marin olarak, <span class="hl">35 yılı aşkın</span> denizcilik elektroniği, seyir cihazları ve gemi otomasyon sistemleri
            deneyimimizi ticari gemilere ve romorkörlere profesyonel çözümler sunmak için kullanıyoruz.
          </p>
        </div>
        <TeamPhoto class="hero__photo" eager />
      </div>
    </header>

    <Journey />
    <section class="mission" aria-labelledby="mission-title">
      <div class="mission__axis" aria-hidden="true"><span></span></div>
      <div class="container mission__inner">
        <h2 class="display mission__big" id="mission-title" data-reveal>
          Erkon Marin’in misyonu, 35 yıllık saha deneyimiyle <em>hızlı, doğru ve kaliteli</em> denizcilik teknik hizmeti sunmaktır.
        </h2>
        <p class="lead mission__lead" data-reveal style="--d:120">
          İster ticari gemi, ister romorkör, ister kıyı operasyon araçları olsun; her bir gemi için güvenilir, profesyonel ve uzun ömürlü
          çözümler üretiyoruz.
        </p>
        <div class="mission__actions" data-reveal style="--d:200">
          <a class="btn btn--signal" href="/iletisim/#talep">
            <span>Servis talebi</span>
            <Icon name="arrow" />
          </a>
          <a class="btn btn--ghost" href="/hizmetler/">
            <span>Hizmetlerimiz</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileDock />
</Base>

<style>
  /* ---- Hero ---------------------------------------------------- */
  .hero {
    padding: calc(var(--header-h) + clamp(48px, 7vw, 112px)) 0 clamp(72px, 9vw, 140px);
    background:
      radial-gradient(60% 80% at 88% 0%, rgba(43, 187, 229, 0.12), transparent 62%),
      var(--c-abyss);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 6vw, 112px);
    align-items: end;
  }
  .hero__title {
    font-size: clamp(56px, 8.4vw, 144px);
  }
  .hero__lead {
    max-width: 30ch;
    margin-top: clamp(28px, 3vw, 48px);
    font-family: var(--f-display);
    font-size: clamp(22px, 2.15vw, 34px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: #dfe6f6;
    text-wrap: pretty;
  }
  .hl {
    color: var(--c-signal);
  }
  .hero__grid :global(.hero__photo) {
    justify-self: end;
  }

  /* ---- Mission ------------------------------------------------- */
  .mission {
    position: relative;
    padding-block: clamp(96px, 12vw, 180px);
    overflow: hidden;
  }
  .mission__axis {
    position: absolute;
    top: clamp(48px, 6vw, 88px);
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--c-signal) 0%, rgba(43, 187, 229, 0.25) 55%, transparent 100%);
  }
  .mission__axis span {
    position: absolute;
    top: -5px;
    /* the container's content edge, so the dot continues the story rail above */
    left: calc(max(0px, (100% - var(--maxw)) / 2) + var(--gutter));
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c-signal);
    box-shadow: 0 0 0 6px rgba(43, 187, 229, 0.16);
  }
  .mission__big {
    max-width: 20ch;
    font-size: clamp(38px, 5vw, 84px);
    line-height: 1;
  }
  .mission__big em {
    color: var(--c-signal);
  }
  .mission__lead {
    max-width: 52ch;
    margin-top: clamp(28px, 3vw, 44px);
    color: var(--c-mist);
  }
  .mission__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(32px, 4vw, 56px);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__grid :global(.hero__photo) {
      justify-self: start;
    }
  }
</style>
