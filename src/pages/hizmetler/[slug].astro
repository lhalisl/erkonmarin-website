---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileDock from '../../components/MobileDock.astro';
import Icon from '../../components/Icon.astro';
import { services, serviceHref, type Service } from '../../data/services';
import { site, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const [lead, ...rest] = service.paragraphs;
const others = services.filter((s) => s.slug !== service.slug);

// Meta description: the opening paragraph, cut on a word boundary
const summary = lead.length > 158 ? `${lead.slice(0, lead.lastIndexOf(' ', 155))}…` : lead;
const message = `Merhaba, ${service.title} için servis talebi oluşturmak istiyorum.`;
---

<Base title={`${service.title} · ${service.subtitle} | Erkon Marin`} description={summary}>
  <Header />
  <main id="main">
    <article aria-labelledby="svc-title">
      <header class="hero">
        <div class="container hero__grid">
          <div class="hero__text">
            <a class="back" href="/hizmetler/">
              <Icon name="arrow" />
              <span>Tüm hizmetler</span>
            </a>
            <h1 class="display hero__title" id="svc-title">
              {service.title}{' '}
              <em>{service.subtitle}</em>
            </h1>
          </div>
          <figure class="hero__media">
            <Image
              src={service.photo.src}
              alt={service.photo.alt}
              widths={[480, 760, 1080]}
              sizes="(max-width: 900px) calc(100vw - 40px), 54vw"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </header>

      <section class="body" data-nav-tone="light" aria-label="Hizmet ayrıntıları">
        <div class="container body__grid">
          <div class="body__text">
            <p class="body__lead">{lead}</p>
            {rest.map((p) => <p>{p}</p>)}
          </div>

          <aside class="ask" aria-labelledby="ask-title">
            <h2 class="h3 ask__title" id="ask-title">Gemi bekliyorsa, <em>hemen</em> arayın.</h2>
            <p class="ask__hours">{site.hours.label}</p>
            <div class="ask__phones">
              {
                site.phones.map((p) => (
                  <a class="ask__phone" href={p.href}>
                    <Icon name="phone" />
                    <span>{p.display}</span>
                  </a>
                ))
              }
            </div>
            <div class="ask__actions">
              <a class="btn btn--ink" href="/iletisim/#talep">
                <span>Servis talebi</span>
                <Icon name="arrow" />
              </a>
              <a class="btn btn--line" href={whatsappLink(message)} target="_blank" rel="noopener">
                <Icon name="whatsapp" />
                <span>WhatsApp</span>
              </a>
            </div>
          </aside>
        </div>
      </section>
    </article>

    <nav class="more" aria-labelledby="more-title">
      <div class="container">
        <h2 class="h2 more__title" id="more-title">Diğer <em>hizmetler</em></h2>
        <ul role="list" class="more__list">
          {
            others.map((s) => (
              <li>
                <a class="card" href={serviceHref(s)}>
                  <Image class="card__img" src={s.photo.src} alt="" widths={[360, 640]} sizes="(max-width: 900px) 40vw, 160px" />
                  <span class="card__text">
                    <span class="card__title">{s.title}</span>
                    <span class="card__sub serif">{s.subtitle}</span>
                  </span>
                  <Icon name="arrow" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </main>
  <Footer />
  <MobileDock />
</Base>

<style>
  .hero {
    padding: calc(var(--header-h) + clamp(40px, 6vw, 96px)) 0 clamp(64px, 8vw, 120px);
    background:
      radial-gradient(70% 90% at 85% 10%, rgba(43, 187, 229, 0.1), transparent 60%),
      var(--c-abyss);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: end;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(40px, 6vw, 88px);
    color: var(--c-mist);
    font-family: var(--f-display);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.25s var(--ease-out);
  }
  .back :global(svg) {
    width: 16px;
    height: 16px;
    transform: rotate(180deg);
    transition: transform 0.35s var(--ease-out);
  }
  .back:hover,
  .back:focus-visible {
    color: var(--c-signal-hi);
  }
  .back:hover :global(svg) {
    transform: rotate(180deg) translateX(4px);
  }
  .hero__title {
    font-size: clamp(48px, 6.4vw, 108px);
  }
  .hero__title em {
    display: block;
    margin-top: 0.12em;
    color: var(--c-signal);
    font-size: 0.62em;
    line-height: 1.05;
  }
  .hero__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-xl);
    aspect-ratio: 4 / 3;
    background: var(--c-night);
  }
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding-block: clamp(72px, 9vw, 140px);
    background: var(--c-paper-hi);
    color: var(--c-ink);
  }
  .body__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(40px, 7vw, 120px);
    align-items: start;
  }
  .body__text {
    display: grid;
    gap: 1.4em;
    max-width: 68ch;
    color: var(--c-ink-2);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.7;
    text-wrap: pretty;
  }
  .body__text .body__lead {
    color: var(--c-ink);
    font-family: var(--f-display);
    font-size: clamp(22px, 2vw, 32px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.012em;
  }
  .ask {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    padding: clamp(28px, 2.6vw, 40px);
    border: 1px solid var(--c-line-light);
    border-radius: var(--r-lg);
    background: #fff;
  }
  .ask__title {
    font-size: clamp(26px, 2.2vw, 34px);
  }
  .ask__title em {
    color: var(--c-navy);
  }
  .ask__hours {
    margin-top: 14px;
    color: var(--c-ink-3);
    font-size: 15px;
  }
  .ask__phones {
    display: grid;
    margin-top: 22px;
    border-top: 1px solid var(--c-line-light);
  }
  .ask__phone {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--c-line-light);
    font-family: var(--f-display);
    font-size: 19px;
    font-weight: 650;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
    transition: color 0.25s var(--ease-out);
  }
  .ask__phone :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--c-navy);
  }
  .ask__phone:hover,
  .ask__phone:focus-visible {
    color: var(--c-navy);
  }
  .ask__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .ask__actions .btn {
    flex: 1 1 auto;
  }
  .btn--line {
    --btn-bd: var(--c-line-light-2);
  }
  .btn--line:hover,
  .btn--line:focus-visible {
    --btn-bd: var(--c-ink);
  }
  .ask :global(:focus-visible) {
    outline-color: var(--c-navy);
  }

  .more {
    padding-block: clamp(80px, 10vw, 150px);
  }
  .more__title {
    font-size: clamp(38px, 4.4vw, 72px);
  }
  .more__title em {
    color: var(--c-signal);
  }
  .more__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .card {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 100%;
    padding: 12px 22px 12px 12px;
    border: 1px solid var(--c-line-dark);
    border-radius: var(--r-lg);
    background: rgba(13, 26, 61, 0.45);
    text-decoration: none;
    transition:
      border-color 0.3s var(--ease-out),
      background-color 0.3s var(--ease-out);
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--c-signal);
    background: rgba(13, 26, 61, 0.8);
  }
  .card :global(.card__img) {
    flex: none;
    width: clamp(88px, 8vw, 120px);
    height: clamp(88px, 8vw, 120px);
    border-radius: var(--r-md);
    object-fit: cover;
  }
  .card__text {
    display: grid;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .card__title {
    font-family: var(--f-display);
    font-size: clamp(19px, 1.5vw, 24px);
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .card__sub {
    color: var(--c-signal);
    font-size: 15px;
    line-height: 1.3;
  }
  .card > :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--c-mist);
    transition:
      transform 0.4s var(--ease-out),
      color 0.3s var(--ease-out);
  }
  .card:hover > :global(svg),
  .card:focus-visible > :global(svg) {
    color: var(--c-signal-hi);
    transform: translateX(4px);
  }

  @media (max-width: 1080px) {
    .body__grid {
      grid-template-columns: 1fr;
    }
    .ask {
      position: static;
      max-width: 560px;
    }
    .more__list {
      grid-template-columns: 1fr;
      max-width: 640px;
    }
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .back {
      margin-bottom: 32px;
    }
    .hero__media {
      border-radius: var(--r-lg);
    }
  }
</style>
